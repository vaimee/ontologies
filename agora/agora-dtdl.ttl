@prefix : <http://onto.vaimee.com/agora/dtdl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@base <http://onto.vaimee.com/agora/dtdl#> .

<http://onto.vaimee.com/agora/dtdl#> rdf:type owl:Ontology ;
                                      owl:versionIRI <http://onto.vaimee.com/agora/dtdl/1.0.0#> ;
                                      owl:imports <http://onto.vaimee.com/dtdl#> ;
                                      dcterms:abstract "DTDL representation of the Agora ontology for digital twin model exchange." ;
                                      dcterms:contributor <https://qrfy.io/p/BJOemlfU0F> ;
                                      dcterms:creator "Luca Roffia" ;
                                      dcterms:description "This ontology provides a Protégé-friendly RDF view of the Agora DTDL model. The canonical DTDL artifact remains the JSON-LD document." ;
                                      dcterms:title "Agora DTDL Ontology" ;
                                      owl:title "Agora DTDL Ontology" ;
                                      owl:versionInfo "1.0.0" .

#################################################################
#    Annotation properties
#################################################################

###  dtmi:dtdl:property:comment;4
<dtmi:dtdl:property:comment;4> rdf:type owl:AnnotationProperty .


###  dtmi:dtdl:property:contents;4
<dtmi:dtdl:property:contents;4> rdf:type owl:AnnotationProperty .


###  dtmi:dtdl:property:description;4
<dtmi:dtdl:property:description;4> rdf:type owl:AnnotationProperty .


###  dtmi:dtdl:property:displayName;4
<dtmi:dtdl:property:displayName;4> rdf:type owl:AnnotationProperty .


###  dtmi:dtdl:property:fields;4
<dtmi:dtdl:property:fields;4> rdf:type owl:AnnotationProperty .


###  dtmi:dtdl:property:name;4
<dtmi:dtdl:property:name;4> rdf:type owl:AnnotationProperty .


###  dtmi:dtdl:property:schema;4
<dtmi:dtdl:property:schema;4> rdf:type owl:AnnotationProperty .


###  dtmi:dtdl:property:target;4
<dtmi:dtdl:property:target;4> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/abstract
dcterms:abstract rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/contributor
dcterms:contributor rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/identifier
dcterms:identifier rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#title
owl:title rdf:type owl:AnnotationProperty .


#################################################################
#    Classes
#################################################################

###  dtmi:dtdl:class:Component;4
<dtmi:dtdl:class:Component;4> rdf:type owl:Class .


###  dtmi:dtdl:class:Field;4
<dtmi:dtdl:class:Field;4> rdf:type owl:Class .


###  dtmi:dtdl:class:Interface;4
<dtmi:dtdl:class:Interface;4> rdf:type owl:Class .


###  dtmi:dtdl:class:Object;4
<dtmi:dtdl:class:Object;4> rdf:type owl:Class .


###  dtmi:dtdl:class:Property;4
<dtmi:dtdl:class:Property;4> rdf:type owl:Class .


###  dtmi:dtdl:class:Relationship;4
<dtmi:dtdl:class:Relationship;4> rdf:type owl:Class .


###  dtmi:dtdl:class:Telemetry;4
<dtmi:dtdl:class:Telemetry;4> rdf:type owl:Class .


###  http://onto.vaimee.com/dtdl/extension/quantitativeTypes/v2/class/Density
<http://onto.vaimee.com/dtdl/extension/quantitativeTypes/v2/class/Density> rdf:type owl:NamedIndividual ,
                                                                               <http://onto.vaimee.com/dtdl/extension/quantitativeTypes/v2/class/QuantitativeType> .


###  http://onto.vaimee.com/dtdl/extension/quantitativeTypes/v2/class/Length
<http://onto.vaimee.com/dtdl/extension/quantitativeTypes/v2/class/Length> rdf:type owl:NamedIndividual ,
                                                                              <http://onto.vaimee.com/dtdl/extension/quantitativeTypes/v2/class/QuantitativeType> .


###  http://onto.vaimee.com/dtdl/extension/quantitativeTypes/v2/class/Pressure
<http://onto.vaimee.com/dtdl/extension/quantitativeTypes/v2/class/Pressure> rdf:type owl:NamedIndividual ,
                                                                                <http://onto.vaimee.com/dtdl/extension/quantitativeTypes/v2/class/QuantitativeType> .


###  http://onto.vaimee.com/dtdl/extension/quantitativeTypes/v2/class/Temperature
<http://onto.vaimee.com/dtdl/extension/quantitativeTypes/v2/class/Temperature> rdf:type owl:NamedIndividual ,
                                                                                   <http://onto.vaimee.com/dtdl/extension/quantitativeTypes/v2/class/QuantitativeType> .


