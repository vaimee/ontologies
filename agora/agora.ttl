criteria:rootDepthZero rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf owl:topDataProperty ;
                       rdfs:domain criteria:RootDevelopment ;
                       rdfs:range xsd:decimal .


###  http://onto.vaimee.com/agora/criteria#rootShape
criteria:rootShape rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf owl:topDataProperty ;
                   rdfs:domain criteria:RootDevelopment ;
                   rdfs:range xsd:integer .


###  http://onto.vaimee.com/agora/criteria#rootShapeDeformation
criteria:rootShapeDeformation rdf:type owl:DatatypeProperty ;
                              rdfs:subPropertyOf owl:topDataProperty ;
                              rdfs:domain criteria:RootDevelopment ;
                              rdfs:range xsd:decimal .


###  http://onto.vaimee.com/agora/criteria#saveDate
criteria:saveDate rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf owl:topDataProperty ;
                  rdfs:domain :Criteria1DPlan ;
                  rdfs:range xsd:dateTime .


###  http://onto.vaimee.com/agora/criteria#saveState
criteria:saveState rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf owl:topDataProperty ;
                   rdfs:domain :Criteria1DPlan ;
                   rdfs:range xsd:boolean .


###  http://onto.vaimee.com/agora/criteria#slope
criteria:slope rdf:type owl:DatatypeProperty ;
               rdfs:subPropertyOf owl:topDataProperty ;
               rdfs:domain :Criteria1DPlan ;
               rdfs:range xsd:decimal .


###  http://onto.vaimee.com/agora/criteria#stressTolerance
criteria:stressTolerance rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf owl:topDataProperty ;
                         rdfs:domain criteria:CropCycle ;
                         rdfs:range xsd:decimal .


###  http://onto.vaimee.com/agora/criteria#useWaterRetentionFitting
criteria:useWaterRetentionFitting rdf:type owl:DatatypeProperty ;
                                  rdfs:subPropertyOf owl:topDataProperty ;
                                  rdfs:domain :Criteria1DPlan ;
                                  rdfs:range xsd:boolean .


###  http://onto.vaimee.com/agora/criteria#useWaterTable
criteria:useWaterTable rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf owl:topDataProperty ;
                       rdfs:domain :Criteria1DPlan ;
                       rdfs:range xsd:boolean .


###  http://onto.vaimee.com/agora/criteria#waterContentDepth
criteria:waterContentDepth rdf:type owl:DatatypeProperty ;
                           rdfs:subPropertyOf owl:topDataProperty ;
                           rdfs:domain :Criteria1DPlan ;
                           rdfs:range xsd:string .


###  http://onto.vaimee.com/agora/criteria#waterPotentialDepth
criteria:waterPotentialDepth rdf:type owl:DatatypeProperty ;
                             rdfs:subPropertyOf owl:topDataProperty ;
                             rdfs:domain :Criteria1DPlan ;
                             rdfs:range xsd:string .


###  http://onto.vaimee.com/fsm#stateName
fsm:stateName rdf:type owl:DatatypeProperty .


###  http://onto.vaimee.com/fsm#symbolValue
fsm:symbolValue rdf:type owl:DatatypeProperty .


###  https://onto.vaimee.com/pac#defaultValue
pac:defaultValue rdf:type owl:DatatypeProperty ;
                 rdfs:isDefinedBy pac: .


###  https://onto.vaimee.com/pac#graphUri
pac:graphUri rdf:type owl:DatatypeProperty ;
             rdfs:domain pac:FixedNamedGraph ;
             rdfs:range xsd:anyURI ;
             rdfs:isDefinedBy pac: .


###  https://onto.vaimee.com/pac#graphUriTemplate
pac:graphUriTemplate rdf:type owl:DatatypeProperty ;
                     rdfs:domain pac:InstanceNamedGraph ;
                     rdfs:range xsd:string ;
                     rdfs:isDefinedBy pac: .


###  https://onto.vaimee.com/pac#sparql
pac:sparql rdf:type owl:DatatypeProperty ;
           rdfs:isDefinedBy pac: .


###  https://onto.vaimee.com/pac#variableName
pac:variableName rdf:type owl:DatatypeProperty ;
                 rdfs:isDefinedBy pac: .


#################################################################
#    Classes
#################################################################

###  http://onto.vaimee.com/agora#AgrohydrologicalModel
:AgrohydrologicalModel rdf:type owl:Class ;
                       rdfs:subClassOf sosa:Procedure ;
                       rdfs:comment "Procedure model used to simulate water, crop, soil, and atmospheric processes for agrohydrological analysis." ;
                       rdfs:label "Agrohydrological model" .


###  http://onto.vaimee.com/agora#Atmosphere
:Atmosphere rdf:type owl:Class ;
            rdfs:subClassOf geo:Feature ,
                            prov:Entity ,
                            sosa:FeatureOfInterest ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty prov:wasGeneratedBy ;
                              owl:someValuesFrom :UpdateAtmosphereActivity
                            ] ,
                            [ rdf:type owl:Restriction ;
                              owl:onProperty sosa:isFeatureOfInterestOf ;
                              owl:allValuesFrom [ owl:intersectionOf ( sosa:Observation
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty sosa:observedProperty ;
                                                                         owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                             owl:oneOf ( :precipitation
                                                                                                         :temperature
                                                                                                       )
                                                                                           ]
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ]
                            ] ;
            rdfs:comment "Atmospheric context associated with a field and updated by weather-related activities." ;
            rdfs:label "Atmosphere" .


###  http://onto.vaimee.com/agora#AtmosphereDigitalTwin
:AtmosphereDigitalTwin rdf:type owl:Class ;
                       rdfs:subClassOf prov:SoftwareAgent ,
                                       sosa:Sensor ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty sosa:madeObservation ;
                                         owl:allValuesFrom :AtmosphereTemperatureObservation
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :hasFiniteStateMachine ;
                                         owl:hasValue :WeatherAgentFSM
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :usesPacComponent ;
                                         owl:hasValue pacc:WeatherAtmosphere
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty :usesPacComponent ;
                                         owl:hasValue pacp:WeatherAgent
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty sosa:observes ;
                                         owl:hasValue :precipitation
                                       ] ,
                                       [ rdf:type owl:Restriction ;
                                         owl:onProperty sosa:observes ;
                                         owl:hasValue :temperature
                                       ] ;
                       rdfs:comment "A software agent acting as a virtual sensor. It observes daily precipitation and maximum, minimum, and average daily temperature, fetching them from external WeatherAPIs and producing AtmosphereObservations for the Atmosphere of a Field." ;
                       rdfs:label "WeatherAgent" .


###  http://onto.vaimee.com/agora#AtmosphereTemperatureObservation
:AtmosphereTemperatureObservation rdf:type owl:Class ;
                                  rdfs:subClassOf sosa:Observation ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty sosa:hasFeatureOfInterest ;
                                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onClass :Atmosphere
                                                  ] ,
                                                  [ rdf:type owl:Restriction ;
                                                    owl:onProperty sosa:hasResult ;
                                                    owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                    owl:onClass :AtmosphereTemperatureResult
                                                  ] ;
                                  rdfs:comment "A daily atmospheric observation for a Field, including daily precipitation and maximum, minimum, and average daily temperature values." ;
                                  rdfs:label "Atmosphere observation" .


###  http://onto.vaimee.com/agora#AtmosphereTemperatureResult
:AtmosphereTemperatureResult rdf:type owl:Class ;
                             rdfs:subClassOf sosa:Result ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :avgDailyTemperature ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:decimal
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :maxDailyTemperature ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:decimal
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :minDailyTemperature ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:decimal
                                             ] ;
                             rdfs:comment "Structured result of an AtmosphereObservation carrying daily maximum, minimum, and average temperature values." ;
                             rdfs:label "Atmosphere temperature result" .


###  http://onto.vaimee.com/agora#Criteria1DPlan
:Criteria1DPlan rdf:type owl:Class ;
                rdfs:subClassOf prov:Plan ;
                rdfs:comment "PROV plan describing how CRITERIA1D is executed within the digital twin workflow." ;
                rdfs:label "CRITERIA1D plan" .


###  http://onto.vaimee.com/agora#Crop
:Crop rdf:type owl:Class ;
      rdfs:subClassOf prov:Entity ,
                      sosa:FeatureOfInterest ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty prov:wasGeneratedBy ;
                        owl:someValuesFrom :RunFieldDigitalTwinActivity
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty sosa:isFeatureOfInterestOf ;
                        owl:allValuesFrom [ owl:intersectionOf ( sosa:Observation
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty sosa:observedProperty ;
                                                                   owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                       owl:oneOf ( :availableWater
                                                                                                   :et0
                                                                                                   :evap
                                                                                                   :evapMax
                                                                                                   :fractionAvailableWater
                                                                                                   :lai
                                                                                                   :readilyAvailableWater
                                                                                                   :rootDepth
                                                                                                   :transp
                                                                                                   :transpMax
                                                                                                 )
                                                                                     ]
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ]
                      ] ;
      rdfs:comment "Crop associated with a field, including crop-related observable properties produced or consumed by the digital twin." ;
      rdfs:label "Crop" .


###  http://onto.vaimee.com/agora#DigitalTwin
:DigitalTwin rdf:type owl:Class ;
             rdfs:comment "Software representation of a physical system that can observe, compute, and coordinate activities through internal agents and models." ;
             rdfs:label "Digital twin" .


###  http://onto.vaimee.com/agora#DigitalTwinSynchronizer
:DigitalTwinSynchronizer rdf:type owl:Class ;
                         rdfs:subClassOf prov:SoftwareAgent ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :hasFiniteStateMachine ;
                                           owl:hasValue :DigitalTwinSynchronizerFSM
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :usesPacComponent ;
                                           owl:hasValue paca:DigitalTwinActivityState
                                         ] ,
                                         [ rdf:type owl:Restriction ;
                                           owl:onProperty :usesPacComponent ;
                                           owl:hasValue pacp:DigitalTwinRunActivity
                                         ] ;
                         rdfs:comment "Software agent responsible for coordinating digital twin activities and triggering model runs after prerequisite activities complete." ;
                         rdfs:label "Digital twin synchronizer" .


###  http://onto.vaimee.com/agora#DigitalTwinSynchronizerAssociation
:DigitalTwinSynchronizerAssociation rdf:type owl:Class ;
                                    rdfs:subClassOf prov:Association ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty prov:agent ;
                                                      owl:someValuesFrom :DigitalTwinSynchronizer
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty prov:hadPlan ;
                                                      owl:someValuesFrom :Criteria1DPlan
                                                    ] ;
                                    rdfs:comment "Qualified PROV association linking a digital twin synchronizer to the plan used for an activity." ;
                                    rdfs:label "Digital twin synchronizer association" .


###  http://onto.vaimee.com/agora#Farm
:Farm rdf:type owl:Class ;
      rdfs:comment "Agricultural holdings (often called farms): an economic unit of agricultural production under single management comprising all livestock kept and all land used wholly or partly for agricultural production purposes, without regard to title, legal form or size” (FAO, 2015)."@en .


###  http://onto.vaimee.com/agora#Field
:Field rdf:type owl:Class ;
       rdfs:subClassOf :PhysicalSystem ,
                       geo:Feature ,
                       prov:Entity ,
                       sosa:FeatureOfInterest ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty prov:wasGeneratedBy ;
                         owl:someValuesFrom :RunFieldDigitalTwinActivity
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty sosa:isFeatureOfInterestOf ;
                         owl:allValuesFrom [ owl:intersectionOf ( sosa:Observation
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty sosa:observedProperty ;
                                                                    owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                        owl:oneOf ( :balance
                                                                                                    :irrigation
                                                                                                  )
                                                                                      ]
                                                                  ]
                                                                ) ;
                                             rdf:type owl:Class
                                           ]
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasAtmosphere ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Atmosphere
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasCrop ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Crop
                       ] ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :hasSoil ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onClass :Soil
                       ] ;
       rdfs:comment "Agricultural field represented as a physical system composed of one atmosphere, one crop, and one soil." ;
       rdfs:label "Field" .


###  http://onto.vaimee.com/agora#FieldDigitalTwin
:FieldDigitalTwin rdf:type owl:Class ;
                  rdfs:subClassOf :DigitalTwin ,
                                  prov:Entity ,
                                  prov:SoftwareAgent ,
                                  sosa:Sensor ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :digitalTwinOf ;
                                    owl:someValuesFrom :Field
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasModel ;
                                    owl:someValuesFrom :AgrohydrologicalModel
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :hasFiniteStateMachine ;
                                    owl:hasValue :FieldDigitalTwinFSM
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty :usesPacComponent ;
                                    owl:hasValue paca:FieldDigitalTwinRun
                                  ] ;
                  rdfs:comment "Digital twin specialization for an agricultural field." ;
                  rdfs:label "FieldDT" .


###  http://onto.vaimee.com/agora#ForecastWeatherObservation
:ForecastWeatherObservation rdf:type owl:Class ;
                            rdfs:subClassOf sosa:Observation ;
                            rdfs:comment "Weather observation whose phenomenon time is at or after the result time." ;
                            rdfs:label "Forecast weather observation" .


###  http://onto.vaimee.com/agora#HistoricalWeatherObservation
:HistoricalWeatherObservation rdf:type owl:Class ;
                              rdfs:subClassOf sosa:Observation ;
                              rdfs:comment "Weather observation whose phenomenon time is before the result time." ;
                              rdfs:label "Historical weather observation" .


###  http://onto.vaimee.com/agora#PhysicalSystem
:PhysicalSystem rdf:type owl:Class ;
                rdfs:comment "Physical entity represented by a digital twin." ;
                rdfs:label "Physical system" .


###  http://onto.vaimee.com/agora#RunFieldDigitalTwinActivity
:RunFieldDigitalTwinActivity rdf:type owl:Class ;
                             rdfs:subClassOf prov:Create ,
                                             prov:Modify ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty prov:generated ;
                                               owl:someValuesFrom :Crop
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty prov:generated ;
                                               owl:someValuesFrom :Field
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty prov:generated ;
                                               owl:someValuesFrom :Soil
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty prov:qualifiedAssociation ;
                                               owl:someValuesFrom :DigitalTwinSynchronizerAssociation
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty prov:used ;
                                               owl:someValuesFrom :FieldDigitalTwin
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty prov:wasAssociatedWith ;
                                               owl:someValuesFrom :DigitalTwinSynchronizer
                                             ] ;
                             rdfs:comment "PROV activity that runs a field digital twin and generates updated field, crop, or soil entities." ;
                             rdfs:label "Run field digital twin activity" .


###  http://onto.vaimee.com/agora#Soil
:Soil rdf:type owl:Class ;
      rdfs:subClassOf prov:Entity ,
                      sosa:FeatureOfInterest ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty prov:wasGeneratedBy ;
                        owl:someValuesFrom :RunFieldDigitalTwinActivity
                      ] ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty sosa:isFeatureOfInterestOf ;
                        owl:allValuesFrom [ owl:intersectionOf ( sosa:Observation
                                                                 [ rdf:type owl:Restriction ;
                                                                   owl:onProperty sosa:observedProperty ;
                                                                   owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                       owl:oneOf ( :capillaryRise
                                                                                                   :drainage
                                                                                                   :lateralDrainage
                                                                                                   :runoff
                                                                                                   :soilWaterContent
                                                                                                   :soilWaterPotential
                                                                                                   :surfaceWaterContent
                                                                                                   :waterContent
                                                                                                 )
                                                                                     ]
                                                                 ]
                                                               ) ;
                                            rdf:type owl:Class
                                          ]
                      ] ;
      rdfs:comment "Soil has also been defined as a natural body consisting of layers (soil horizons) that are composed of weathered mineral materials, organic material, air and water." ;
      rdfs:label "Soil" ;
      rdfs:seeAlso <https://www.fao.org/soils-portal/about/all-definitions/en> .


###  http://onto.vaimee.com/agora#SoilHorizon
:SoilHorizon rdf:type owl:Class ;
             rdfs:subClassOf prov:Entity ,
                             sosa:FeatureOfInterest ,
                             [ rdf:type owl:Restriction ;
                               owl:onProperty sosa:isFeatureOfInterestOf ;
                               owl:allValuesFrom [ owl:intersectionOf ( sosa:Observation
                                                                        [ rdf:type owl:Restriction ;
                                                                          owl:onProperty sosa:observedProperty ;
                                                                          owl:allValuesFrom [ rdf:type owl:Class ;
                                                                                              owl:oneOf ( :bulkDensity
                                                                                                          :coarseFragment
                                                                                                          :kSat
                                                                                                          :organicMatter
                                                                                                          :soilTexture
                                                                                                          :thetaSat
                                                                                                        )
                                                                                            ]
                                                                        ]
                                                                      ) ;
                                                   rdf:type owl:Class
                                                 ]
                             ] ;
             rdfs:comment "A soil horizon is a layer, approximately parallel to the surface of the soil, that is distinguishable from adjacent layers by a distinctive set of properties produced by the soil-forming processes." ;
             rdfs:label "Soil horizon" .


###  http://onto.vaimee.com/agora#SoilTextureObservation
:SoilTextureObservation rdf:type owl:Class ;
                        rdfs:subClassOf sosa:Observation ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty sosa:observedProperty ;
                                          owl:hasValue :soilTexture
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty sosa:hasFeatureOfInterest ;
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass :SoilHorizon
                                        ] ,
                                        [ rdf:type owl:Restriction ;
                                          owl:onProperty sosa:hasResult ;
                                          owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                          owl:onClass :SoilTextureResult
                                        ] ;
                        rdfs:comment "Observation of soil texture, producing a result composed of sand, silt, and clay fractions." ;
                        rdfs:label "Soil texture observation" .


###  http://onto.vaimee.com/agora#SoilTextureResult
:SoilTextureResult rdf:type owl:Class ;
                   rdfs:subClassOf sosa:Result ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :clay ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:decimal
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :sand ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:decimal
                                   ] ,
                                   [ rdf:type owl:Restriction ;
                                     owl:onProperty :silt ;
                                     owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                     owl:onDataRange xsd:decimal
                                   ] ;
                   rdfs:comment "Structured result of a soil texture observation, composed of sand, silt, and clay fractions." ;
                   rdfs:label "Soil texture result" .


###  http://onto.vaimee.com/agora#SoilWaterContentObservation
:SoilWaterContentObservation rdf:type owl:Class ;
                             rdfs:subClassOf sosa:Observation ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty sosa:observedProperty ;
                                               owl:hasValue :soilWaterContent
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty sosa:hasFeatureOfInterest ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onClass :Soil
                                             ] ,
                                             [ rdf:type owl:Restriction ;
                                               owl:onProperty :observedDepth ;
                                               owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                               owl:onDataRange xsd:decimal
                                             ] ;
                             rdfs:comment "Observation of soil water content at a specific depth." ;
                             rdfs:label "Soil water content observation" .


###  http://onto.vaimee.com/agora#SoilWaterPotentialObservation
:SoilWaterPotentialObservation rdf:type owl:Class ;
                               rdfs:subClassOf sosa:Observation ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty sosa:observedProperty ;
                                                 owl:hasValue :soilWaterPotential
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty sosa:hasFeatureOfInterest ;
                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onClass :Soil
                                               ] ,
                                               [ rdf:type owl:Restriction ;
                                                 owl:onProperty :observedDepth ;
                                                 owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                 owl:onDataRange xsd:decimal
                                               ] ;
                               rdfs:comment "Observation of soil water potential at a specific depth." ;
                               rdfs:label "Soil water potential observation" .


###  http://onto.vaimee.com/agora#State
:State rdf:type owl:Class ;
       rdfs:subClassOf fsm:State ,
                       time:TemporalEntity ;
       rdfs:comment "State of a software agent or finite-state machine at a temporal instant or interval." ;
       rdfs:label "State" .


###  http://onto.vaimee.com/agora#UpdateAtmosphereActivity
:UpdateAtmosphereActivity rdf:type owl:Class ;
                          rdfs:subClassOf prov:Create ,
                                          prov:Modify ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty prov:generated ;
                                            owl:someValuesFrom :Atmosphere
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty prov:used ;
                                            owl:someValuesFrom api:WeatherAPI
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty prov:wasAssociatedWith ;
                                            owl:someValuesFrom :AtmosphereDigitalTwin
                                          ] ;
                          rdfs:comment "PROV activity that updates the atmosphere using data from a weather API and is associated with a weather agent." ;
                          rdfs:label "Update atmosphere activity" .


###  http://onto.vaimee.com/agora/api#WeatherAPI
api:WeatherAPI rdf:type owl:Class ;
               rdfs:subClassOf prov:Entity .


###  http://onto.vaimee.com/agora/criteria#AgroHydrologicalModelComponent
criteria:AgroHydrologicalModelComponent rdf:type owl:Class ;
                                        rdfs:comment "Functional component of an agrohydrological model, such as a crop cycle, irrigation, or root development component." ;
                                        rdfs:label "Agrohydrlogical model component" .


###  http://onto.vaimee.com/agora/criteria#CRITERIA1D
criteria:CRITERIA1D rdf:type owl:Class ;
                    rdfs:subClassOf :AgrohydrologicalModel ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty criteria:hasCropCycle ;
                                      owl:someValuesFrom criteria:CropCycle
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty criteria:hasIrrigation ;
                                      owl:someValuesFrom criteria:Irrigation
                                    ] ,
                                    [ rdf:type owl:Restriction ;
                                      owl:onProperty criteria:hasRootDevelopment ;
                                      owl:someValuesFrom criteria:RootDevelopment
                                    ] ;
                    rdfs:comment "Agrohydrological model composed of crop cycle, irrigation, and root development components." ;
                    rdfs:label "CRITERIA1D" ;
                    rdfs:seeAlso "https://github.com/ARPA-SIMC/CRITERIA1D" .


###  http://onto.vaimee.com/agora/criteria#CropCycle
criteria:CropCycle rdf:type owl:Class ;
                   rdfs:subClassOf criteria:AgroHydrologicalModelComponent ;
                   rdfs:comment "CRITERIA component describing crop-cycle parameters and phenological development." ;
                   rdfs:label "Crop cycle" .


###  http://onto.vaimee.com/agora/criteria#Irrigation
criteria:Irrigation rdf:type owl:Class ;
                    rdfs:subClassOf criteria:AgroHydrologicalModelComponent ;
                    rdfs:comment "CRITERIA component describing irrigation configuration and scheduling parameters." ;
                    rdfs:label "Irrigation" .


###  http://onto.vaimee.com/agora/criteria#RootDevelopment
criteria:RootDevelopment rdf:type owl:Class ;
                         rdfs:subClassOf criteria:AgroHydrologicalModelComponent ;
                         rdfs:comment "CRITERIA component describing root development parameters." ;
                         rdfs:label "Root development" .


