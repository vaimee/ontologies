#################################################################
#    Individuals
#################################################################

###  http://onto.vaimee.com/agora#ActivityBinding
:ActivityBinding rdf:type owl:NamedIndividual ,
                          pac:UriForcedBinding ;
                 pac:variableName "activity" ;
                 rdfs:comment "Runtime URI binding for the digital twin run activity handled by a PAC operation." ;
                 rdfs:label "activity binding" .


###  http://onto.vaimee.com/agora#ApiFetchFailedSymbol
:ApiFetchFailedSymbol rdf:type owl:NamedIndividual ,
                               fsm:Symbol ;
                      fsm:symbolValue "api fetch failed" ;
                      rdfs:label "api fetch failed" .


###  http://onto.vaimee.com/agora#ApiFetchSucceededSymbol
:ApiFetchSucceededSymbol rdf:type owl:NamedIndividual ,
                                  fsm:Symbol ;
                         fsm:symbolValue "api fetch succeeded" ;
                         rdfs:label "api fetch succeeded" .


###  http://onto.vaimee.com/agora#AtmosphereBinding
:AtmosphereBinding rdf:type owl:NamedIndividual ,
                            pac:UriForcedBinding ;
                   pac:variableName "atmosphere" ;
                   rdfs:comment "Runtime URI binding for the atmosphere targeted by a weather update operation." ;
                   rdfs:label "atmosphere binding" .


###  http://onto.vaimee.com/agora#AtmosphereTemperatureResultShape
:AtmosphereTemperatureResultShape rdf:type owl:NamedIndividual ,
                                           shacl:NodeShape ;
                                  shacl:property [ shacl:datatype xsd:decimal ;
                                                   shacl:maxCount 1 ;
                                                   shacl:minCount 1 ;
                                                   shacl:path :maxDailyTemperature
                                                 ] ,
                                                 [ shacl:datatype xsd:decimal ;
                                                   shacl:maxCount 1 ;
                                                   shacl:minCount 1 ;
                                                   shacl:path :avgDailyTemperature
                                                 ] ,
                                                 [ shacl:datatype xsd:decimal ;
                                                   shacl:lessThan :maxDailyTemperature ;
                                                   shacl:maxCount 1 ;
                                                   shacl:minCount 1 ;
                                                   shacl:path :minDailyTemperature
                                                 ] ;
                                  shacl:targetClass :AtmosphereTemperatureResult .


###  http://onto.vaimee.com/agora#AtmosphereUpdateCompletedSymbol
:AtmosphereUpdateCompletedSymbol rdf:type owl:NamedIndividual ,
                                          fsm:Symbol ;
                                 fsm:symbolValue "atmosphere update completed" ;
                                 rdfs:label "atmosphere update completed" .


###  http://onto.vaimee.com/agora#AtmosphereUpdateFailedSymbol
:AtmosphereUpdateFailedSymbol rdf:type owl:NamedIndividual ,
                                       fsm:Symbol ;
                              fsm:symbolValue "atmosphere update failed" ;
                              rdfs:label "atmosphere update failed" .


###  http://onto.vaimee.com/agora#DigitalTwinActivityHistoricalGraph
:DigitalTwinActivityHistoricalGraph rdf:type owl:NamedIndividual ,
                                             pac:FixedNamedGraph ,
                                             pac:HistoricalGraph ;
                                    pac:graphUri "http://onto.vaimee.com/agora/graphs/activities"^^xsd:anyURI ;
                                    rdfs:comment "Fixed historical named graph containing persisted digital twin activities and their state." ;
                                    rdfs:label "Digital twin activity historical graph" .


###  http://onto.vaimee.com/agora#DigitalTwinActivityLiveGraph
:DigitalTwinActivityLiveGraph rdf:type owl:NamedIndividual ,
                                       pac:FixedNamedGraph ,
                                       pac:LiveGraph ;
                              pac:graphUri "http://onto.vaimee.com/agora/graphs/live/activities"^^xsd:anyURI ;
                              rdfs:comment "Fixed live named graph used to notify digital twin activity changes." ;
                              rdfs:label "Digital twin activity live graph" .


###  http://onto.vaimee.com/agora#DigitalTwinBinding
:DigitalTwinBinding rdf:type owl:NamedIndividual ,
                             pac:UriForcedBinding ;
                    pac:variableName "digitalTwin" ;
                    rdfs:comment "Runtime URI binding used to resolve digital-twin-scoped graph URI templates." ;
                    rdfs:label "digital twin binding" .


###  http://onto.vaimee.com/agora#DigitalTwinGraphBinding
:DigitalTwinGraphBinding rdf:type owl:NamedIndividual ,
                                  pac:UriForcedBinding ;
                         pac:variableName "digitalTwinGraph" ;
                         rdfs:comment "Runtime URI binding for the named graph resolved from a digital twin instance graph template." ;
                         rdfs:label "digital twin graph binding" .


###  http://onto.vaimee.com/agora#DigitalTwinInstanceHistoricalGraph
:DigitalTwinInstanceHistoricalGraph rdf:type owl:NamedIndividual ,
                                             pac:HistoricalGraph ,
                                             pac:InstanceNamedGraph ;
                                    pac:graphTemplateBinding :DigitalTwinBinding ;
                                    pac:graphUriTemplate "http://onto.vaimee.com/agora/graphs/digital-twin/{digitalTwin}" ;
                                    rdfs:comment "Historical named graph scoped to a digital twin instance. It stores observations and model outputs for the field, crop, and soil represented by that digital twin." ;
                                    rdfs:label "Digital twin instance historical graph" .


###  http://onto.vaimee.com/agora#DigitalTwinInstanceLiveGraph
:DigitalTwinInstanceLiveGraph rdf:type owl:NamedIndividual ,
                                       pac:InstanceNamedGraph ,
                                       pac:LiveGraph ;
                              pac:graphTemplateBinding :DigitalTwinBinding ;
                              pac:graphUriTemplate "http://onto.vaimee.com/agora/graphs/live/digital-twin/{digitalTwin}" ;
                              rdfs:comment "Live named graph scoped to a digital twin instance and used to notify changes in observations and model outputs." ;
                              rdfs:label "Digital twin instance live graph" .


###  http://onto.vaimee.com/agora#DigitalTwinSynchronizerAlphabet
:DigitalTwinSynchronizerAlphabet rdf:type owl:NamedIndividual ,
                                          fsm:Alphabet ;
                                 fsm:hasSymbol :AtmosphereUpdateCompletedSymbol ,
                                               :AtmosphereUpdateFailedSymbol ,
                                               :FieldTwinCompletedSymbol ,
                                               :FieldTwinFailedSymbol ,
                                               :FieldTwinStartFailedSymbol ,
                                               :FieldTwinStartedSymbol ,
                                               :ResetSymbol ,
                                               :RunRequestedSymbol ;
                                 rdfs:label "Digital twin synchronizer alphabet" .


###  http://onto.vaimee.com/agora#DigitalTwinSynchronizerFSM
:DigitalTwinSynchronizerFSM rdf:type owl:NamedIndividual ,
                                     fsm:DeterministicFiniteStateMachine ;
                            fsm:hasAcceptingState :SynchronizerCompletedState ,
                                                  :SynchronizerFailedState ;
                            fsm:hasAlphabet :DigitalTwinSynchronizerAlphabet ;
                            fsm:hasInitialState :SynchronizerIdleState ;
                            fsm:hasState :SynchronizerCompletedState ,
                                         :SynchronizerFailedState ,
                                         :SynchronizerIdleState ,
                                         :SynchronizerStartingFieldTwinState ,
                                         :SynchronizerWaitingAtmosphereState ,
                                         :SynchronizerWaitingFieldTwinState ;
                            fsm:hasTransition :SynchronizerAtmosphereFailedTransition ,
                                              :SynchronizerAtmosphereUpdatedTransition ,
                                              :SynchronizerFieldTwinCompletedTransition ,
                                              :SynchronizerFieldTwinFailedTransition ,
                                              :SynchronizerFieldTwinStartFailedTransition ,
                                              :SynchronizerFieldTwinStartedTransition ,
                                              :SynchronizerResetAfterCompletedTransition ,
                                              :SynchronizerResetAfterFailedTransition ,
                                              :SynchronizerRunRequestedTransition ;
                            rdfs:comment "Finite-state machine used to trace orchestration of weather updates and field digital twin execution." ;
                            rdfs:label "Digital twin synchronizer FSM" .


###  http://onto.vaimee.com/agora#FetchRequestedSymbol
:FetchRequestedSymbol rdf:type owl:NamedIndividual ,
                               fsm:Symbol ;
                      fsm:symbolValue "fetch requested" ;
                      rdfs:label "fetch requested" .


###  http://onto.vaimee.com/agora#FieldBinding
:FieldBinding rdf:type owl:NamedIndividual ,
                       pac:UriForcedBinding ;
              pac:variableName "field" ;
              rdfs:comment "Runtime URI binding for the field handled by a PAC operation." ;
              rdfs:label "field binding" .


###  http://onto.vaimee.com/agora#FieldDigitalTwinAlphabet
:FieldDigitalTwinAlphabet rdf:type owl:NamedIndividual ,
                                   fsm:Alphabet ;
                          fsm:hasSymbol :InputReadySymbol ,
                                        :ModelExecutionFailedSymbol ,
                                        :ModelExecutionSucceededSymbol ,
                                        :ModelStartFailedSymbol ,
                                        :ModelStartedSymbol ,
                                        :OutputPublishedSymbol ,
                                        :ResetSymbol ,
                                        :RunRequestedSymbol ;
                          rdfs:label "Field digital twin alphabet" .


###  http://onto.vaimee.com/agora#FieldDigitalTwinCompletedState
:FieldDigitalTwinCompletedState rdf:type owl:NamedIndividual ,
                                         fsm:AcceptingState ;
                                fsm:stateName "completed" ;
                                rdfs:label "Field digital twin completed" .


###  http://onto.vaimee.com/agora#FieldDigitalTwinFSM
:FieldDigitalTwinFSM rdf:type owl:NamedIndividual ,
                              fsm:DeterministicFiniteStateMachine ;
                     fsm:hasAcceptingState :FieldDigitalTwinCompletedState ,
                                           :FieldDigitalTwinFailedState ;
                     fsm:hasAlphabet :FieldDigitalTwinAlphabet ;
                     fsm:hasInitialState :FieldDigitalTwinIdleState ;
                     fsm:hasState :FieldDigitalTwinCompletedState ,
                                  :FieldDigitalTwinFailedState ,
                                  :FieldDigitalTwinIdleState ,
                                  :FieldDigitalTwinPublishingOutputState ,
                                  :FieldDigitalTwinRunningModelState ,
                                  :FieldDigitalTwinStartingModelState ,
                                  :FieldDigitalTwinWaitingInputState ;
                     fsm:hasTransition :FieldDigitalTwinInputReadyTransition ,
                                       :FieldDigitalTwinModelFailedTransition ,
                                       :FieldDigitalTwinModelStartFailedTransition ,
                                       :FieldDigitalTwinModelStartedTransition ,
                                       :FieldDigitalTwinModelSucceededTransition ,
                                       :FieldDigitalTwinOutputPublishedTransition ,
                                       :FieldDigitalTwinResetAfterCompletedTransition ,
                                       :FieldDigitalTwinResetAfterFailedTransition ,
                                       :FieldDigitalTwinRunRequestedTransition ;
                     rdfs:comment "Finite-state machine used to trace field digital twin model execution and distinguish model start failures from runtime failures." ;
                     rdfs:label "Field digital twin FSM" .


###  http://onto.vaimee.com/agora#FieldDigitalTwinFailedState
:FieldDigitalTwinFailedState rdf:type owl:NamedIndividual ,
                                      fsm:AcceptingState ;
                             fsm:stateName "failed" ;
                             rdfs:label "Field digital twin failed" .


###  http://onto.vaimee.com/agora#FieldDigitalTwinIdleState
:FieldDigitalTwinIdleState rdf:type owl:NamedIndividual ,
                                    fsm:InitialState ;
                           fsm:stateName "idle" ;
                           rdfs:label "Field digital twin idle" .


###  http://onto.vaimee.com/agora#FieldDigitalTwinInputReadyTransition
:FieldDigitalTwinInputReadyTransition rdf:type owl:NamedIndividual ,
                                               fsm:DeterministicTransition ;
                                      fsm:fromState :FieldDigitalTwinWaitingInputState ;
                                      fsm:onSymbol :InputReadySymbol ;
                                      fsm:toState :FieldDigitalTwinStartingModelState .


###  http://onto.vaimee.com/agora#FieldDigitalTwinModelFailedTransition
:FieldDigitalTwinModelFailedTransition rdf:type owl:NamedIndividual ,
                                                fsm:DeterministicTransition ;
                                       fsm:fromState :FieldDigitalTwinRunningModelState ;
                                       fsm:onSymbol :ModelExecutionFailedSymbol ;
                                       fsm:toState :FieldDigitalTwinFailedState .


###  http://onto.vaimee.com/agora#FieldDigitalTwinModelStartFailedTransition
:FieldDigitalTwinModelStartFailedTransition rdf:type owl:NamedIndividual ,
                                                     fsm:DeterministicTransition ;
                                            fsm:fromState :FieldDigitalTwinStartingModelState ;
                                            fsm:onSymbol :ModelStartFailedSymbol ;
                                            fsm:toState :FieldDigitalTwinFailedState .


###  http://onto.vaimee.com/agora#FieldDigitalTwinModelStartedTransition
:FieldDigitalTwinModelStartedTransition rdf:type owl:NamedIndividual ,
                                                 fsm:DeterministicTransition ;
                                        fsm:fromState :FieldDigitalTwinStartingModelState ;
                                        fsm:onSymbol :ModelStartedSymbol ;
                                        fsm:toState :FieldDigitalTwinRunningModelState .


###  http://onto.vaimee.com/agora#FieldDigitalTwinModelSucceededTransition
:FieldDigitalTwinModelSucceededTransition rdf:type owl:NamedIndividual ,
                                                   fsm:DeterministicTransition ;
                                          fsm:fromState :FieldDigitalTwinRunningModelState ;
                                          fsm:onSymbol :ModelExecutionSucceededSymbol ;
                                          fsm:toState :FieldDigitalTwinPublishingOutputState .


###  http://onto.vaimee.com/agora#FieldDigitalTwinOutputPublishedTransition
:FieldDigitalTwinOutputPublishedTransition rdf:type owl:NamedIndividual ,
                                                    fsm:DeterministicTransition ;
                                           fsm:fromState :FieldDigitalTwinPublishingOutputState ;
                                           fsm:onSymbol :OutputPublishedSymbol ;
                                           fsm:toState :FieldDigitalTwinCompletedState .


###  http://onto.vaimee.com/agora#FieldDigitalTwinPublishingOutputState
:FieldDigitalTwinPublishingOutputState rdf:type owl:NamedIndividual ,
                                                fsm:State ;
                                       fsm:stateName "publishing output" ;
                                       rdfs:label "Field digital twin publishing output" .


###  http://onto.vaimee.com/agora#FieldDigitalTwinResetAfterCompletedTransition
:FieldDigitalTwinResetAfterCompletedTransition rdf:type owl:NamedIndividual ,
                                                        fsm:DeterministicTransition ;
                                               fsm:fromState :FieldDigitalTwinCompletedState ;
                                               fsm:onSymbol :ResetSymbol ;
                                               fsm:toState :FieldDigitalTwinIdleState .


###  http://onto.vaimee.com/agora#FieldDigitalTwinResetAfterFailedTransition
:FieldDigitalTwinResetAfterFailedTransition rdf:type owl:NamedIndividual ,
                                                     fsm:DeterministicTransition ;
                                            fsm:fromState :FieldDigitalTwinFailedState ;
                                            fsm:onSymbol :ResetSymbol ;
                                            fsm:toState :FieldDigitalTwinIdleState .


###  http://onto.vaimee.com/agora#FieldDigitalTwinRunRequestedTransition
:FieldDigitalTwinRunRequestedTransition rdf:type owl:NamedIndividual ,
                                                 fsm:DeterministicTransition ;
                                        fsm:fromState :FieldDigitalTwinIdleState ;
                                        fsm:onSymbol :RunRequestedSymbol ;
                                        fsm:toState :FieldDigitalTwinWaitingInputState .


###  http://onto.vaimee.com/agora#FieldDigitalTwinRunningModelState
:FieldDigitalTwinRunningModelState rdf:type owl:NamedIndividual ,
                                            fsm:State ;
                                   fsm:stateName "running model" ;
                                   rdfs:label "Field digital twin running model" .


###  http://onto.vaimee.com/agora#FieldDigitalTwinStartingModelState
:FieldDigitalTwinStartingModelState rdf:type owl:NamedIndividual ,
                                             fsm:State ;
                                    fsm:stateName "starting model" ;
                                    rdfs:label "Field digital twin starting model" .


###  http://onto.vaimee.com/agora#FieldDigitalTwinWaitingInputState
:FieldDigitalTwinWaitingInputState rdf:type owl:NamedIndividual ,
                                            fsm:State ;
                                   fsm:stateName "waiting input" ;
                                   rdfs:label "Field digital twin waiting input" .


###  http://onto.vaimee.com/agora#FieldTwinCompletedSymbol
:FieldTwinCompletedSymbol rdf:type owl:NamedIndividual ,
                                   fsm:Symbol ;
                          fsm:symbolValue "field twin completed" ;
                          rdfs:label "field twin completed" .


###  http://onto.vaimee.com/agora#FieldTwinFailedSymbol
:FieldTwinFailedSymbol rdf:type owl:NamedIndividual ,
                                fsm:Symbol ;
                       fsm:symbolValue "field twin failed" ;
                       rdfs:label "field twin failed" .


###  http://onto.vaimee.com/agora#FieldTwinStartFailedSymbol
:FieldTwinStartFailedSymbol rdf:type owl:NamedIndividual ,
                                     fsm:Symbol ;
                            fsm:symbolValue "field twin start failed" ;
                            rdfs:label "field twin start failed" .


###  http://onto.vaimee.com/agora#FieldTwinStartedSymbol
:FieldTwinStartedSymbol rdf:type owl:NamedIndividual ,
                                 fsm:Symbol ;
                        fsm:symbolValue "field twin started" ;
                        rdfs:label "field twin started" .


###  http://onto.vaimee.com/agora#ForecastObservationShape
:ForecastObservationShape rdf:type owl:NamedIndividual ,
                                   shacl:NodeShape ;
                          shacl:sparql [ shacl:message "Forecast weather observations must have phenomenon time equal to or after result time." ;
                                         shacl:select """PREFIX sosa: <http://www.w3.org/ns/sosa/>
                                        PREFIX time: <http://www.w3.org/2006/time#>

                                        SELECT $this
                                        WHERE {
                                            $this sosa:phenomenonTime/time:inXSDDateTime ?ptime ;
                                                  sosa:resultTime ?resultTime .
                                            FILTER (?ptime >= ?resultTime)
                                        }"""
                                       ] ;
                          shacl:targetClass :ForecastWeatherObservation .


###  http://onto.vaimee.com/agora#HistoricalObservationShape
:HistoricalObservationShape rdf:type owl:NamedIndividual ,
                                     shacl:NodeShape ;
                            shacl:sparql [ shacl:message "Historical weather observations must have phenomenon time before result time." ;
                                           shacl:select """PREFIX sosa: <http://www.w3.org/ns/sosa/>
                                        PREFIX time: <http://www.w3.org/2006/time#>

                                        SELECT $this
                                        WHERE {
                                            $this sosa:phenomenonTime/time:inXSDDateTime ?ptime ;
                                                  sosa:resultTime ?resultTime .
                                            FILTER (?ptime < ?resultTime)
                                        }"""
                                         ] ;
                            shacl:targetClass :HistoricalWeatherObservation .


###  http://onto.vaimee.com/agora#InputReadySymbol
:InputReadySymbol rdf:type owl:NamedIndividual ,
                           fsm:Symbol ;
                  fsm:symbolValue "input ready" ;
                  rdfs:label "input ready" .


