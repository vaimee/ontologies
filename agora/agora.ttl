###  http://onto.vaimee.com/agora#WeatherAgentFSM
:WeatherAgentFSM rdf:type owl:NamedIndividual ,
                          fsm:DeterministicFiniteStateMachine ;
                 fsm:hasAcceptingState :WeatherAgentCompletedState ,
                                       :WeatherAgentFailedState ;
                 fsm:hasAlphabet :WeatherAgentAlphabet ;
                 fsm:hasInitialState :WeatherAgentIdleState ;
                 fsm:hasState :WeatherAgentCompletedState ,
                              :WeatherAgentFailedState ,
                              :WeatherAgentFetchingState ,
                              :WeatherAgentIdleState ,
                              :WeatherAgentPublishingState ,
                              :WeatherAgentValidatingState ;
                 fsm:hasTransition :WeatherAgentFetchFailedTransition ,
                                   :WeatherAgentFetchRequestedTransition ,
                                   :WeatherAgentFetchSucceededTransition ,
                                   :WeatherAgentObservationPublishedTransition ,
                                   :WeatherAgentResetAfterCompletedTransition ,
                                   :WeatherAgentResetAfterFailedTransition ,
                                   :WeatherAgentValidationFailedTransition ,
                                   :WeatherAgentValidationSucceededTransition ;
                 rdfs:comment "Finite-state machine used to trace weather data acquisition, validation, publication, and API fetch errors." ;
                 rdfs:label "Weather agent FSM" .


