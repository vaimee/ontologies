###  https://onto.vaimee.com/pac/aggregator#DigitalTwinActivityState
paca:DigitalTwinActivityState rdf:type owl:NamedIndividual ,
                                       pac:Aggregator ;
                              pac:performsSubscription pacq:DigitalTwinActivityState ;
                              pac:performsUpdate pacu:DigitalTwinSynchronizationState ;
                              rdfs:comment "PAC aggregator used by the digital twin synchronizer to react to activity state notifications and update orchestration state." ;
                              rdfs:label "Digital twin activity state aggregator" .


###  https://onto.vaimee.com/pac/aggregator#FieldDigitalTwinRun
paca:FieldDigitalTwinRun rdf:type owl:NamedIndividual ,
                                  pac:Aggregator ;
                         pac:performsSubscription pacq:FieldDigitalTwinRunActivity ;
                         pac:performsUpdate pacu:FieldDigitalTwinOutput ;
                         rdfs:comment "PAC aggregator used by the field digital twin to react to run activities and produce updated field, crop, soil, and model outputs." ;
                         rdfs:label "Field digital twin run aggregator" .


###  https://onto.vaimee.com/pac/consumer#WeatherAtmosphere
pacc:WeatherAtmosphere rdf:type owl:NamedIndividual ,
                                pac:Consumer ;
                       pac:performsQuery pacq:ListAtmospheresForWeatherUpdate ;
                       rdfs:comment "PAC consumer used by the weather agent to retrieve the atmospheres that need weather updates." ;
                       rdfs:label "Weather atmosphere consumer" .


