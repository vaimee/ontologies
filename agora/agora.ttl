pacp:DigitalTwinRunActivity rdf:type owl:NamedIndividual ,
                                     pac:Producer ;
                            pac:performsUpdate pacu:CreateFieldDigitalTwinRunActivity ;
                            rdfs:comment "PAC producer used by the digital twin synchronizer to create field digital twin run activities." ;
                            rdfs:label "Digital twin run activity producer" .


###  https://onto.vaimee.com/pac/producer#WeatherAgent
pacp:WeatherAgent rdf:type owl:NamedIndividual ,
                           pac:Producer ;
                  pac:performsUpdate pacu:AtmosphereObservation ;
                  rdfs:comment "PAC producer used by the weather agent to publish atmosphere observations fetched from weather APIs." ;
                  rdfs:label "Weather agent PAC producer" .


###  https://onto.vaimee.com/pac/query#DigitalTwinActivityState
pacq:DigitalTwinActivityState rdf:type owl:NamedIndividual ,
                                       pac:Query ;
                              pac:subscribesToGraph :DigitalTwinActivityLiveGraph ;
                              pac:sparql "SELECT ?activity ?state WHERE { GRAPH <http://onto.vaimee.com/agora/graphs/live/activities> { ?activity a <http://www.w3.org/ns/prov#Activity> ; <http://onto.vaimee.com/agora#hasState> ?state . } }" ;
                              rdfs:comment "Subscription query used by the synchronizer to observe activity state changes." ;
                              rdfs:label "Digital twin activity state subscription" .


###  https://onto.vaimee.com/pac/query#FieldDigitalTwinRunActivity
pacq:FieldDigitalTwinRunActivity rdf:type owl:NamedIndividual ,
                                          pac:Query ;
                                 pac:subscribesToGraph :DigitalTwinActivityLiveGraph ;
                                 pac:sparql "SELECT ?activity ?field WHERE { GRAPH <http://onto.vaimee.com/agora/graphs/live/activities> { ?activity a <http://onto.vaimee.com/agora#RunFieldDigitalTwinActivity> ; <http://www.w3.org/ns/prov#used> ?field . } }" ;
                                 rdfs:comment "Subscription query used by the field digital twin to detect run activities concerning fields." ;
                                 rdfs:label "Field digital twin run activity subscription" .


###  https://onto.vaimee.com/pac/query#ListAtmospheresForWeatherUpdate
pacq:ListAtmospheresForWeatherUpdate rdf:type owl:NamedIndividual ,
                                              pac:Query ;
                                     pac:hasForcedBinding :DigitalTwinGraphBinding ;
                                     pac:readsFromGraph :DigitalTwinInstanceHistoricalGraph ;
                                     pac:sparql "SELECT ?field ?atmosphere WHERE { GRAPH ?digitalTwinGraph { ?field <http://onto.vaimee.com/agora#hasAtmosphere> ?atmosphere . } }" ;
                                     rdfs:comment "SPARQL query used by the weather agent to discover atmospheres associated with fields." ;
                                     rdfs:label "List atmospheres for weather update query" .


###  https://onto.vaimee.com/pac/update#AtmosphereObservation
pacu:AtmosphereObservation rdf:type owl:NamedIndividual ,
                                    pac:Update ;
                           pac:hasForcedBinding :AtmosphereBinding ,
                                                :DigitalTwinGraphBinding ,
                                                :ObservationTimeBinding ,
                                                :WeatherValueBinding ;
                           pac:writesToGraph :DigitalTwinInstanceHistoricalGraph ;
                           pac:sparql "INSERT { GRAPH ?digitalTwinGraph { ?observation a <http://www.w3.org/ns/sosa/Observation> ; <http://www.w3.org/ns/sosa/hasFeatureOfInterest> ?atmosphere ; <http://www.w3.org/ns/sosa/resultTime> ?time ; <http://www.w3.org/ns/sosa/hasSimpleResult> ?value . } } WHERE { BIND(IRI(CONCAT(\"http://onto.vaimee.com/agora#weather-observation-\", STRUUID())) AS ?observation) }" ;
                           rdfs:comment "SPARQL update template used by the weather agent to publish atmosphere observations. Atmosphere, time, and weather value are forced bindings supplied at runtime." ;
                           rdfs:label "Upsert atmosphere observation update" .


###  https://onto.vaimee.com/pac/update#CreateFieldDigitalTwinRunActivity
pacu:CreateFieldDigitalTwinRunActivity rdf:type owl:NamedIndividual ,
                                                pac:Update ;
                                       pac:hasForcedBinding :FieldBinding ;
                                       pac:writesToGraph :DigitalTwinActivityHistoricalGraph ;
                                       pac:sparql "INSERT { GRAPH <http://onto.vaimee.com/agora/graphs/activities> { ?activity a <http://www.w3.org/ns/prov#Activity>, <http://onto.vaimee.com/agora#RunFieldDigitalTwinActivity> ; <http://www.w3.org/ns/prov#used> ?field . } } WHERE { BIND(IRI(CONCAT(\"http://onto.vaimee.com/agora#run-\", STRUUID())) AS ?activity) }" ;
                                       rdfs:comment "SPARQL update template used to create a run activity for a field. The field binding is supplied at runtime by the synchronizer." ;
                                       rdfs:label "Create field digital twin run activity update" .


###  https://onto.vaimee.com/pac/update#DigitalTwinSynchronizationState
pacu:DigitalTwinSynchronizationState rdf:type owl:NamedIndividual ,
                                              pac:Update ;
                                     pac:hasForcedBinding :ActivityBinding ;
                                     pac:writesToGraph :DigitalTwinActivityHistoricalGraph ;
                                     pac:sparql "INSERT { GRAPH <http://onto.vaimee.com/agora/graphs/activities> { ?activity <http://onto.vaimee.com/agora#hasState> ?nextState . } } WHERE { }" ;
                                     rdfs:comment "SPARQL update template used by the synchronizer to write the next orchestration state after receiving activity notifications." ;
                                     rdfs:label "Update digital twin synchronization state" .


###  https://onto.vaimee.com/pac/update#FieldDigitalTwinOutput
pacu:FieldDigitalTwinOutput rdf:type owl:NamedIndividual ,
                                     pac:Update ;
                            pac:hasForcedBinding :ActivityBinding ,
                                                 :DigitalTwinGraphBinding ,
                                                 :FieldBinding ;
                            pac:writesToGraph :DigitalTwinInstanceHistoricalGraph ;
                            pac:sparql "INSERT { GRAPH ?digitalTwinGraph { ?field <http://www.w3.org/ns/prov#wasGeneratedBy> ?activity . } } WHERE { }" ;
                            rdfs:comment "SPARQL update template used by the field digital twin after CRITERIA1D execution to write generated output triples. Runtime bindings identify the run activity, field, and computed values." ;
                            rdfs:label "Update field digital twin output" .


