:ObservationTimeBinding rdf:type owl:NamedIndividual ,
                                 pac:LiteralForcedBinding ;
                        pac:variableName "time" ;
                        rdfs:comment "Runtime literal binding for an observation result time." ;
                        rdfs:label "observation time binding" .


