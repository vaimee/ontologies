criteria:degreeDaysLaiIncrease rdf:type owl:DatatypeProperty ;
                               rdfs:subPropertyOf owl:topDataProperty ;
                               rdfs:domain criteria:CropCycle ;
                               rdfs:range xsd:integer .


###  http://onto.vaimee.com/agora/criteria#degreeDaysRootIncrease
criteria:degreeDaysRootIncrease rdf:type owl:DatatypeProperty ;
                                rdfs:subPropertyOf owl:topDataProperty ;
                                rdfs:domain criteria:RootDevelopment ;
                                rdfs:range xsd:integer .


###  http://onto.vaimee.com/agora/criteria#degreeDaysStartIrrigation
criteria:degreeDaysStartIrrigation rdf:type owl:DatatypeProperty ;
                                   rdfs:subPropertyOf owl:topDataProperty ;
                                   rdfs:domain criteria:Irrigation ;
                                   rdfs:range xsd:integer .


