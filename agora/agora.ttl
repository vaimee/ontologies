fsm:DeterministicTransition rdf:type owl:Class .


###  http://onto.vaimee.com/fsm#FiniteStateMachine
fsm:FiniteStateMachine rdf:type owl:Class .


###  http://onto.vaimee.com/fsm#InitialState
fsm:InitialState rdf:type owl:Class .


###  http://onto.vaimee.com/fsm#State
fsm:State rdf:type owl:Class ;
          rdfs:comment "State class imported from the VAIMEE finite-state machine ontology." ;
          rdfs:label "FSM state" .


###  http://onto.vaimee.com/fsm#Symbol
fsm:Symbol rdf:type owl:Class .


###  http://qudt.org/schema/qudt/QuantityValue
qudt:QuantityValue rdf:type owl:Class ;
                   rdfs:comment "QUDT class for quantity values composed of numeric values and units." ;
                   rdfs:label "Quantity value" .


###  http://www.opengis.net/ont/geosparql#Feature
geo:Feature rdf:type owl:Class ;
            rdfs:comment "GeoSPARQL class for spatial features." ;
            rdfs:label "GeoSPARQL feature" .


###  http://www.w3.org/2006/time#TemporalEntity
time:TemporalEntity rdf:type owl:Class ;
                    rdfs:comment "OWL-Time class for temporal entities such as instants and intervals." ;
                    rdfs:label "Temporal entity" .


###  http://www.w3.org/ns/prov#SoftwareAgent
prov:SoftwareAgent rdf:type owl:Class ;
                   rdfs:comment "PROV class for agents implemented as software." ;
                   rdfs:label "Software agent" .


###  http://www.w3.org/ns/shacl#NodeShape
shacl:NodeShape rdf:type owl:Class ;
                rdfs:comment "SHACL class for node shapes used to validate RDF nodes." ;
                rdfs:label "Node shape" .


###  http://www.w3.org/ns/sosa/Actuator
sosa:Actuator rdf:type owl:Class ;
              rdfs:comment "SOSA class for devices or agents that execute acts on behalf of a procedure." ;
              rdfs:label "Actuator" .


###  http://www.w3.org/ns/sosa/FeatureOfInterest
sosa:FeatureOfInterest rdf:type owl:Class ;
                       rdfs:comment "SOSA class for entities whose properties are observed or acted upon." ;
                       rdfs:label "Feature of interest" .


###  http://www.w3.org/ns/sosa/ObservableProperty
sosa:ObservableProperty rdf:type owl:Class ;
                        rdfs:comment "SOSA class for properties that can be observed." ;
                        rdfs:label "Observable property" .


###  http://www.w3.org/ns/sosa/Observation
sosa:Observation rdf:type owl:Class ;
                 rdfs:comment "SOSA class for acts of observing a property of a feature of interest." ;
                 rdfs:label "Observation" .


###  http://www.w3.org/ns/sosa/Procedure
sosa:Procedure rdf:type owl:Class ;
               rdfs:comment "SOSA class for workflows, protocols, plans, algorithms, or computational methods used by sensors or actuators." ;
               rdfs:label "Procedure" .


###  http://www.w3.org/ns/sosa/Result
sosa:Result rdf:type owl:Class ;
            rdfs:comment "SOSA class for the result of an observation or actuation." ;
            rdfs:label "Result" .


###  http://www.w3.org/ns/sosa/Sensor
sosa:Sensor rdf:type owl:Class ;
            rdfs:comment "SOSA class for entities that observe properties and produce observations." ;
            rdfs:label "Sensor" .


