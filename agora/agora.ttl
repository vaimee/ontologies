@prefix : <http://onto.vaimee.com/agora#> .
@prefix api: <http://onto.vaimee.com/agora/api#> .
@prefix fsm: <http://onto.vaimee.com/fsm#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix pac: <https://onto.vaimee.com/pac#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix auth: <https://auth.vaimee.com/profile#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix paca: <https://onto.vaimee.com/pac/aggregator#> .
@prefix pacc: <https://onto.vaimee.com/pac/consumer#> .
@prefix pacp: <https://onto.vaimee.com/pac/producer#> .
@prefix pacq: <https://onto.vaimee.com/pac/query#> .
@prefix pacu: <https://onto.vaimee.com/pac/update#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix swrl: <http://www.w3.org/2003/11/swrl#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix shacl: <http://www.w3.org/ns/shacl#> .
@prefix swrlb: <http://www.w3.org/2003/11/swrlb#> .
@prefix schema: <http://schema.org/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix criteria: <http://onto.vaimee.com/agora/criteria#> .
@base <http://onto.vaimee.com/agora#> .

<http://onto.vaimee.com/agora#> rdf:type owl:Ontology ;
                                 owl:versionIRI <http://onto.vaimee.com/agora/1.0.24#> ;
                                 owl:imports <http://onto.vaimee.com/agora/api/0.1> ,
                                             <http://www.w3.org/ns/prov-20130430> ,
                                             sosa: ,
                                             <https://onto.vaimee.com/fsm/fsm.ttl> ;
                                 dcterms:abstract "This ontology designed for farmers to monitor and optimize irrigation procedures and, in the future, other activities related to precision agriculture." ;
                                 dcterms:contributor "Bita Alaee" ,
                                                     "Gregorio Monari" ;
                                 dcterms:creator "Luca Roffia" ;
                                 dcterms:description "This ontology manages the relationship between weather observations, crop growth parameters, and soil horizons for precision irrigation." ;
                                 dcterms:title "Agorà Ontology" ;
                                 rdfs:comment "Implementation note: a Protege plugin should be developed to visualize and edit the finite-state machines of the software agents." ;
                                 owl:title "Agorà Ontology" ;
                                 owl:versionInfo "1.0.24" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/abstract
dcterms:abstract rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/contributor
dcterms:contributor rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#comment
rdfs:comment rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2000/01/rdf-schema#label
rdfs:label rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#qualifiedCardinality
owl:qualifiedCardinality rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#title
owl:title rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#broadMatch
skos:broadMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
skos:closeMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#exactMatch
skos:exactMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#relatedMatch
skos:relatedMatch rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#datatype
shacl:datatype rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#lessThan
shacl:lessThan rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#maxCount
shacl:maxCount rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#message
shacl:message rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#minCount
shacl:minCount rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#minExclusive
shacl:minExclusive rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#path
shacl:path rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#property
shacl:property rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#select
shacl:select rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#sparql
shacl:sparql rdf:type owl:AnnotationProperty .


###  http://www.w3.org/ns/shacl#targetClass
shacl:targetClass rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/homepage
foaf:homepage rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/member
foaf:member rdf:type owl:AnnotationProperty .


###  http://xmlns.com/foaf/0.1/name
foaf:name rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://onto.vaimee.com/agora#digitalTwinOf
:digitalTwinOf rdf:type owl:ObjectProperty ;
               rdfs:domain :DigitalTwin ;
               rdfs:range :PhysicalSystem ;
               rdfs:comment "Links a DigitalTwin to the physical field it represents." ;
               rdfs:label "digitalTwinOf" .


###  http://onto.vaimee.com/agora#hasAtmosphere
:hasAtmosphere rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf owl:topObjectProperty ;
               rdfs:domain :Field ;
               rdfs:range :Atmosphere .


###  http://onto.vaimee.com/agora#hasCrop
:hasCrop rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf owl:topObjectProperty ;
         rdfs:domain :Field ;
         rdfs:range :Crop .


###  http://onto.vaimee.com/agora#hasFiniteStateMachine
:hasFiniteStateMachine rdf:type owl:ObjectProperty ;
                       rdfs:domain prov:SoftwareAgent ;
                       rdfs:range fsm:FiniteStateMachine ;
                       rdfs:comment "Links a software agent to the finite-state machine that describes and traces its runtime behaviour." ;
                       rdfs:label "has finite-state machine" .


###  http://onto.vaimee.com/agora#hasModel
:hasModel rdf:type owl:ObjectProperty ;
          rdfs:domain :FieldDigitalTwin ;
          rdfs:range :AgrohydrologicalModel ;
          rdfs:comment "Links a DigitalTwin to a model used by the twin." ;
          rdfs:label "hasModel" .


###  http://onto.vaimee.com/agora#hasSoil
:hasSoil rdf:type owl:ObjectProperty ;
         rdfs:subPropertyOf owl:topObjectProperty ;
         rdfs:domain :Field ;
         rdfs:range :Soil .


###  http://onto.vaimee.com/agora#hasSoilHorizon
:hasSoilHorizon rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf owl:topObjectProperty ;
                rdfs:domain :Soil ;
                rdfs:range :SoilHorizon .


###  http://onto.vaimee.com/agora#hasSoilTexture
:hasSoilTexture rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf sosa:hasResult ;
                rdfs:domain :SoilTextureObservation ;
                rdfs:range :SoilTextureResult .


###  http://onto.vaimee.com/agora#hasState
:hasState rdf:type owl:ObjectProperty ;
          rdfs:domain prov:SoftwareAgent ;
          rdfs:range :State .


###  http://onto.vaimee.com/agora#usesPacComponent
:usesPacComponent rdf:type owl:ObjectProperty ;
                  rdfs:domain prov:SoftwareAgent ;
                  rdfs:range pac:PacComponent ;
                  rdfs:comment "Links a software agent to one reusable PAC component used to query, subscribe to, or update the digital twin knowledge base." ;
                  rdfs:label "uses PAC component" .


###  http://onto.vaimee.com/agora/criteria#hasCropCycle
criteria:hasCropCycle rdf:type owl:ObjectProperty ;
                      rdfs:subPropertyOf criteria:hasModelComponent ;
                      rdfs:domain criteria:CRITERIA1D ;
                      rdfs:range criteria:CropCycle ;
                      rdfs:comment "Links a CRITERIA1D model to its crop cycle component." ;
                      rdfs:label "hasCropCycle" .


###  http://onto.vaimee.com/agora/criteria#hasIrrigation
criteria:hasIrrigation rdf:type owl:ObjectProperty ;
                       rdfs:subPropertyOf criteria:hasModelComponent ;
                       rdfs:domain criteria:CRITERIA1D ;
                       rdfs:range criteria:Irrigation ;
                       rdfs:comment "Links a CRITERIA1D model to its irrigation component." ;
                       rdfs:label "hasIrrigation" .


###  http://onto.vaimee.com/agora/criteria#hasModelComponent
criteria:hasModelComponent rdf:type owl:ObjectProperty ;
                           rdfs:domain :AgrohydrologicalModel ;
                           rdfs:range criteria:AgroHydrologicalModelComponent ;
                           rdfs:comment "Links an agrohydrological model to one of its functional components." ;
                           rdfs:label "has model component" .


###  http://onto.vaimee.com/agora/criteria#hasRootDevelopment
criteria:hasRootDevelopment rdf:type owl:ObjectProperty ;
                            rdfs:subPropertyOf criteria:hasModelComponent ;
                            rdfs:domain criteria:CRITERIA1D ;
                            rdfs:range criteria:RootDevelopment ;
                            rdfs:comment "Links a CRITERIA1D model to its root development component." ;
                            rdfs:label "hasRootDevelopment" .


###  http://onto.vaimee.com/fsm#fromState
fsm:fromState rdf:type owl:ObjectProperty .


###  http://onto.vaimee.com/fsm#hasAcceptingState
fsm:hasAcceptingState rdf:type owl:ObjectProperty .


###  http://onto.vaimee.com/fsm#hasAlphabet
fsm:hasAlphabet rdf:type owl:ObjectProperty .


###  http://onto.vaimee.com/fsm#hasInitialState
fsm:hasInitialState rdf:type owl:ObjectProperty .


###  http://onto.vaimee.com/fsm#hasState
fsm:hasState rdf:type owl:ObjectProperty .


###  http://onto.vaimee.com/fsm#hasSymbol
fsm:hasSymbol rdf:type owl:ObjectProperty .


###  http://onto.vaimee.com/fsm#hasTransition
fsm:hasTransition rdf:type owl:ObjectProperty .


###  http://onto.vaimee.com/fsm#onSymbol
fsm:onSymbol rdf:type owl:ObjectProperty .


###  http://onto.vaimee.com/fsm#toState
fsm:toState rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/hasFeatureOfInterest
sosa:hasFeatureOfInterest rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/hasResult
sosa:hasResult rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/isFeatureOfInterestOf
sosa:isFeatureOfInterestOf rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/madeObservation
sosa:madeObservation rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/observedProperty
sosa:observedProperty rdf:type owl:ObjectProperty .


###  http://www.w3.org/ns/sosa/observes
sosa:observes rdf:type owl:ObjectProperty .


###  https://onto.vaimee.com/pac#graphTemplateBinding
pac:graphTemplateBinding rdf:type owl:ObjectProperty ;
                         rdfs:isDefinedBy pac: .


###  https://onto.vaimee.com/pac#hasForcedBinding
pac:hasForcedBinding rdf:type owl:ObjectProperty ;
                     rdfs:isDefinedBy pac: .


###  https://onto.vaimee.com/pac#performsQuery
pac:performsQuery rdf:type owl:ObjectProperty ;
                  rdfs:isDefinedBy pac: .


###  https://onto.vaimee.com/pac#performsSubscription
pac:performsSubscription rdf:type owl:ObjectProperty ;
                         rdfs:isDefinedBy pac: .


###  https://onto.vaimee.com/pac#performsUpdate
pac:performsUpdate rdf:type owl:ObjectProperty ;
                   rdfs:isDefinedBy pac: .


###  https://onto.vaimee.com/pac#readsFromGraph
pac:readsFromGraph rdf:type owl:ObjectProperty ;
                   rdfs:isDefinedBy pac: .


###  https://onto.vaimee.com/pac#subscribesToGraph
pac:subscribesToGraph rdf:type owl:ObjectProperty ;
                      rdfs:isDefinedBy pac: .


###  https://onto.vaimee.com/pac#writesToGraph
pac:writesToGraph rdf:type owl:ObjectProperty ;
                  rdfs:isDefinedBy pac: .


#################################################################
#    Data properties
#################################################################

###  http://onto.vaimee.com/agora#avgDailyTemperature
:avgDailyTemperature rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf owl:topDataProperty ;
                     rdfs:domain :AtmosphereTemperatureResult ;
                     rdfs:range xsd:decimal ;
                     rdfs:comment "Average daily temperature value associated with an atmosphere observation result." ;
                     rdfs:label "average daily temperature" .


###  http://onto.vaimee.com/agora#clay
:clay rdf:type owl:DatatypeProperty ;
      rdfs:subPropertyOf owl:topDataProperty ;
      rdfs:domain :SoilTextureResult ;
      rdfs:range xsd:decimal ;
      rdfs:label "Argilla"@it .


###  http://onto.vaimee.com/agora#dailyPrecipitation
:dailyPrecipitation rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf owl:topDataProperty ;
                    rdfs:domain :AtmosphereTemperatureResult ;
                    rdfs:range xsd:decimal ;
                    rdfs:comment "Daily precipitation value associated with an atmosphere observation result." ;
                    rdfs:label "daily precipitation" .


###  http://onto.vaimee.com/agora#degreeDaysEmergence
:degreeDaysEmergence rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf owl:topDataProperty ;
                     rdfs:domain :Crop ;
                     rdfs:range xsd:integer .


###  http://onto.vaimee.com/agora#kcMax
:kcMax rdf:type owl:DatatypeProperty ;
       rdfs:subPropertyOf owl:topDataProperty ;
       rdfs:domain :Crop ;
       rdfs:range xsd:decimal ;
       rdfs:seeAlso "https://www.fao.org/4/x0490e/x0490e0b.htm" .


###  http://onto.vaimee.com/agora#lowerDepth
:lowerDepth rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain :SoilHorizon ;
            rdfs:range xsd:decimal .


###  http://onto.vaimee.com/agora#maxDailyTemperature
:maxDailyTemperature rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf owl:topDataProperty ;
                     rdfs:domain :AtmosphereTemperatureResult ;
                     rdfs:range xsd:decimal ;
                     rdfs:comment "Maximum daily temperature value associated with an atmosphere observation result." ;
                     rdfs:label "maximum daily temperature" .


###  http://onto.vaimee.com/agora#minDailyTemperature
:minDailyTemperature rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf owl:topDataProperty ;
                     rdfs:domain :AtmosphereTemperatureResult ;
                     rdfs:range xsd:decimal ;
                     rdfs:comment "Minimum daily temperature value associated with an atmosphere observation result." ;
                     rdfs:label "minimum daily temperature" .


###  http://onto.vaimee.com/agora#observedDepth
:observedDepth rdf:type owl:DatatypeProperty ;
               rdfs:domain [ rdf:type owl:Class ;
                             owl:unionOf ( :SoilWaterContentObservation
                                           :SoilWaterPotentialObservation
                                         )
                           ] ;
               rdfs:range xsd:decimal ;
               rdfs:comment "Depth at which a soil observation is made." ;
               rdfs:label "observed depth" .


###  http://onto.vaimee.com/agora#plantCycleMaxDuration
:plantCycleMaxDuration rdf:type owl:DatatypeProperty ;
                       rdfs:subPropertyOf owl:topDataProperty ;
                       rdfs:domain :Crop ;
                       rdfs:range xsd:string .


###  http://onto.vaimee.com/agora#rawFraction
:rawFraction rdf:type owl:DatatypeProperty ;
             rdfs:subPropertyOf owl:topDataProperty ;
             rdfs:domain :Crop ;
             rdfs:range xsd:decimal ;
             rdfs:seeAlso "https://www.fao.org/4/x0490e/x0490e0e.htm" .


###  http://onto.vaimee.com/agora#rootDepthMax
:rootDepthMax rdf:type owl:DatatypeProperty ;
              rdfs:subPropertyOf owl:topDataProperty ;
              rdfs:domain :Crop ;
              rdfs:range xsd:decimal .


###  http://onto.vaimee.com/agora#sand
:sand rdf:type owl:DatatypeProperty ;
      rdfs:subPropertyOf owl:topDataProperty ;
      rdfs:domain :SoilTextureResult ;
      rdfs:range xsd:decimal ;
      rdfs:label "Sabbia"@it .


###  http://onto.vaimee.com/agora#silt
:silt rdf:type owl:DatatypeProperty ;
      rdfs:subPropertyOf owl:topDataProperty ;
      rdfs:domain :SoilTextureResult ;
      rdfs:range xsd:decimal ;
      rdfs:label "Limo"@it .


###  http://onto.vaimee.com/agora#sowingDoy
:sowingDoy rdf:type owl:DatatypeProperty ;
           rdfs:subPropertyOf owl:topDataProperty ;
           rdfs:domain :Crop ;
           rdfs:range xsd:integer .


###  http://onto.vaimee.com/agora#thermalThreshold
:thermalThreshold rdf:type owl:DatatypeProperty ;
                  rdfs:subPropertyOf owl:topDataProperty ;
                  rdfs:domain :Crop ;
                  rdfs:range xsd:decimal .


###  http://onto.vaimee.com/agora#upperDepth
:upperDepth rdf:type owl:DatatypeProperty ;
            rdfs:subPropertyOf owl:topDataProperty ;
            rdfs:domain :SoilHorizon ;
            rdfs:range xsd:decimal .


###  http://onto.vaimee.com/agora#upperThermalThreshold
:upperThermalThreshold rdf:type owl:DatatypeProperty ;
