criteria:irriRatio rdf:type owl:DatatypeProperty ;
                   rdfs:subPropertyOf owl:topDataProperty ;
                   rdfs:domain criteria:Irrigation ;
                   rdfs:range xsd:decimal .


###  http://onto.vaimee.com/agora/criteria#irrigationShift
criteria:irrigationShift rdf:type owl:DatatypeProperty ;
                         rdfs:subPropertyOf owl:topDataProperty ;
                         rdfs:domain criteria:Irrigation ;
