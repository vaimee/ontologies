criteria:restartDate rdf:type owl:DatatypeProperty ;
                     rdfs:subPropertyOf owl:topDataProperty ;
                     rdfs:domain :Criteria1DPlan ;
                     rdfs:range xsd:dateTime .


###  http://onto.vaimee.com/agora/criteria#restartState
criteria:restartState rdf:type owl:DatatypeProperty ;
                      rdfs:subPropertyOf owl:topDataProperty ;
                      rdfs:domain :Criteria1DPlan ;
                      rdfs:range xsd:boolean .


