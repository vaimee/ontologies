@prefix : <http://harmoni-project.eu/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix harmoni: <http://harmoni-project.eu/ontology#> .
@base <http://harmoni-project.eu/ontology> .

<http://harmoni-project.eu/ontology> rdf:type owl:Ontology ;
                                      owl:versionIRI <http://harmoni-project.eu/ontology/1.0.0> ;
                                      dcterms:abstract "Taxonomy of data sources for the HARMONI project, mapping open-access and institutional datasets, catalogues and services to use cases, hazards, publishers, data type families and access conditions."@en ;
                                      dcterms:created "2026-06-24" ;
                                      dcterms:creator "VAIMEE" ;
                                      dcterms:description "Taxonomy of data type families relevant to HARMONI project, with the open-access and institutional data sources mapped to each of the six HARMONI use cases, their publishers, thematic classification and access conditions. Supports Figure 6.1 of Deliverable D1.1 and provides the initial structure for the HARMONI Knowledge Graph developed in T1.4."@en ;
                                      dcterms:title "HARMONI Data Source Ontology"@en ;
                                      owl:versionInfo "1.0.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/terms/created
dcterms:created rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
dcterms:creator rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
dcterms:description rdf:type owl:AnnotationProperty ;
                    rdfs:label "description"@en .


###  http://purl.org/dc/terms/title
dcterms:title rdf:type owl:AnnotationProperty ;
              rdfs:label "title"@en .


###  http://www.w3.org/2004/02/skos/core#definition
skos:definition rdf:type owl:AnnotationProperty ;
                rdfs:label "definition"@en .


###  http://www.w3.org/2004/02/skos/core#prefLabel
skos:prefLabel rdf:type owl:AnnotationProperty ;
               rdfs:label "preferred label"@en .


###  http://www.w3.org/ns/dcat#landingPage
dcat:landingPage rdf:type owl:AnnotationProperty ;
                 rdfs:label "landing page"@en .


###  http://xmlns.com/foaf/0.1/homepage
foaf:homepage rdf:type owl:AnnotationProperty ;
              rdfs:label "homepage"@en .


#################################################################
#    Object Properties
#################################################################

###  http://harmoni-project.eu/ontology#addressesHazard
harmoni:addressesHazard rdf:type owl:ObjectProperty ;
                        rdfs:domain harmoni:UseCase ;
                        rdfs:range harmoni:Hazard ;
                        rdfs:label "addresses hazard"@en .


###  http://harmoni-project.eu/ontology#hasAccessTier
harmoni:hasAccessTier rdf:type owl:ObjectProperty ;
                      rdfs:domain dcat:Resource ;
                      rdfs:range harmoni:AccessTier ;
                      rdfs:comment "States the access and licensing condition of a data source, so that open, partially open and institutional sources can be distinguished."@en ;
                      rdfs:label "has access tier"@en .


###  http://harmoni-project.eu/ontology#relevantToHazard
harmoni:relevantToHazard rdf:type owl:ObjectProperty ;
                         rdfs:domain dcat:Resource ;
                         rdfs:range harmoni:Hazard ;
                         rdfs:comment "Links a data source to a hazard for which it is operationally relevant."@en ;
                         rdfs:label "relevant to hazard"@en .


###  http://harmoni-project.eu/ontology#usedInUseCase
harmoni:usedInUseCase rdf:type owl:ObjectProperty ;
                      rdfs:domain dcat:Resource ;
                      rdfs:range harmoni:UseCase ;
                      rdfs:comment "Links a data source to a HARMONI use case in which it is used."@en ;
                      rdfs:label "used in use case"@en .


###  http://purl.org/dc/terms/isPartOf
dcterms:isPartOf rdf:type owl:ObjectProperty ;
                 rdfs:label "is part of"@en .


###  http://purl.org/dc/terms/publisher
dcterms:publisher rdf:type owl:ObjectProperty ;
                  rdfs:range foaf:Agent ;
                  rdfs:label "publisher"@en .


###  http://purl.org/dc/terms/spatial
dcterms:spatial rdf:type owl:ObjectProperty ;
                rdfs:range harmoni:Region ;
                rdfs:label "spatial coverage"@en .


###  http://www.w3.org/2004/02/skos/core#inScheme
skos:inScheme rdf:type owl:ObjectProperty ;
              rdfs:range skos:ConceptScheme ;
              rdfs:label "in scheme"@en .


###  http://www.w3.org/ns/dcat#catalog
dcat:catalog rdf:type owl:ObjectProperty ;
             rdfs:domain dcat:Catalog ;
             rdfs:range dcat:Catalog ;
             rdfs:label "has sub-catalogue"@en .


###  http://www.w3.org/ns/dcat#dataset
dcat:dataset rdf:type owl:ObjectProperty ;
             rdfs:domain dcat:Catalog ;
             rdfs:range dcat:Dataset ;
             rdfs:label "has dataset"@en .


###  http://www.w3.org/ns/dcat#servesDataset
dcat:servesDataset rdf:type owl:ObjectProperty ;
                   rdfs:domain dcat:DataService ;
                   rdfs:range dcat:Dataset ;
                   rdfs:label "serves dataset"@en .


###  http://www.w3.org/ns/dcat#theme
dcat:theme rdf:type owl:ObjectProperty ;
           rdfs:domain dcat:Resource ;
           rdfs:range skos:Concept ;
           rdfs:label "theme"@en .


#################################################################
#    Classes
#################################################################

###  http://harmoni-project.eu/ontology#AccessTier
harmoni:AccessTier rdf:type owl:Class ;
                   rdfs:comment "Access and licensing condition of a data source, following the verification criteria of Section 6.2.8 of D1.1."@en ;
                   rdfs:label "access tier"@en .


###  http://harmoni-project.eu/ontology#Country
harmoni:Country rdf:type owl:Class ;
                rdfs:subClassOf harmoni:Region ;
                rdfs:label "country"@en .


###  http://harmoni-project.eu/ontology#Hazard
harmoni:Hazard rdf:type owl:Class ;
               rdfs:label "hazard"@en .


###  http://harmoni-project.eu/ontology#NaturalHazard
harmoni:NaturalHazard rdf:type owl:Class ;
                      rdfs:subClassOf harmoni:Hazard ;
                      rdfs:label "natural hazard"@en .


###  http://harmoni-project.eu/ontology#Region
harmoni:Region rdf:type owl:Class ;
               rdfs:comment "Geographic coverage of a data source or use case."@en ;
               rdfs:label "region"@en .


###  http://harmoni-project.eu/ontology#SubRegion
harmoni:SubRegion rdf:type owl:Class ;
                  rdfs:subClassOf harmoni:Region ;
                  rdfs:comment "The pilot area within a country in which a use case is situated."@en ;
                  rdfs:label "sub-region"@en .


###  http://harmoni-project.eu/ontology#TechnologicalHazard
harmoni:TechnologicalHazard rdf:type owl:Class ;
                            rdfs:subClassOf harmoni:Hazard ;
                            rdfs:label "technological hazard"@en .


###  http://harmoni-project.eu/ontology#UseCase
harmoni:UseCase rdf:type owl:Class ;
                rdfs:comment "A HARMONI study case as defined in Chapter 5 of D1.1."@en ;
                rdfs:label "use case"@en .


###  http://www.w3.org/2004/02/skos/core#Concept
skos:Concept rdf:type owl:Class ;
             rdfs:label "concept"@en .


###  http://www.w3.org/2004/02/skos/core#ConceptScheme
skos:ConceptScheme rdf:type owl:Class ;
                   rdfs:label "concept scheme"@en .


###  http://www.w3.org/ns/dcat#Catalog
dcat:Catalog rdf:type owl:Class ;
             rdfs:subClassOf dcat:Resource ;
             rdfs:label "catalogue"@en .


###  http://www.w3.org/ns/dcat#DataService
dcat:DataService rdf:type owl:Class ;
                 rdfs:subClassOf dcat:Resource ;
                 rdfs:label "data service"@en .


###  http://www.w3.org/ns/dcat#Dataset
dcat:Dataset rdf:type owl:Class ;
             rdfs:subClassOf dcat:Resource ;
             rdfs:label "dataset"@en .


###  http://www.w3.org/ns/dcat#Resource
dcat:Resource rdf:type owl:Class ;
              rdfs:label "resource"@en .


###  http://xmlns.com/foaf/0.1/Agent
foaf:Agent rdf:type owl:Class ;
           rdfs:label "agent"@en .


###  http://xmlns.com/foaf/0.1/Organization
foaf:Organization rdf:type owl:Class ;
                  rdfs:subClassOf foaf:Agent ;
                  rdfs:label "organisation"@en .


#################################################################
#    Individuals
#################################################################

###  http://harmoni-project.eu/ontology#AEMET
harmoni:AEMET rdf:type owl:NamedIndividual ,
                       foaf:Organization ;
              rdfs:label "AEMET, Spanish State Meteorological Agency"@en ;
              foaf:homepage <https://www.aemet.es/> .


###  http://harmoni-project.eu/ontology#AEMETFireWeatherIndex
harmoni:AEMETFireWeatherIndex rdf:type owl:NamedIndividual ,
                                       dcat:Dataset ;
                              harmoni:hasAccessTier harmoni:OpenAccess ;
                              harmoni:relevantToHazard harmoni:Wildfire ;
                              harmoni:usedInUseCase harmoni:UC1 ;
                              dcterms:publisher harmoni:AEMET ;
                              dcterms:spatial harmoni:Spain ;
                              dcat:theme harmoni:WildfireFireWeather ;
                              dcterms:title "AEMET Fire Weather Index products"@en .


###  http://harmoni-project.eu/ontology#AEMETObservations
harmoni:AEMETObservations rdf:type owl:NamedIndividual ,
                                   dcat:Dataset ;
                          harmoni:hasAccessTier harmoni:OpenAccess ;
                          harmoni:usedInUseCase harmoni:UC1 ;
                          dcterms:publisher harmoni:AEMET ;
                          dcterms:spatial harmoni:Spain ;
                          dcat:theme harmoni:MeteoObsForecast ;
                          dcterms:title "AEMET observations, forecasts and meteorological warnings"@en .


###  http://harmoni-project.eu/ontology#AEMETOpenData
harmoni:AEMETOpenData rdf:type owl:NamedIndividual ,
                               dcat:DataService ;
                      harmoni:hasAccessTier harmoni:OpenAccess ;
                      harmoni:usedInUseCase harmoni:UC1 ;
                      dcterms:publisher harmoni:AEMET ;
                      dcterms:spatial harmoni:Spain ;
                      dcat:servesDataset harmoni:AEMETFireWeatherIndex ,
                                         harmoni:AEMETObservations ;
                      dcterms:title "AEMET OpenData"@en ;
                      dcat:landingPage <https://opendata.aemet.es/> .


###  http://harmoni-project.eu/ontology#AFAD
harmoni:AFAD rdf:type owl:NamedIndividual ,
                      foaf:Organization ;
             rdfs:label "AFAD, Disaster and Emergency Management Presidency of Türkiye"@en ;
             foaf:homepage <https://www.afad.gov.tr/> .


