###  http://harmoni-project.eu/ontology#DataFamilyScheme
harmoni:DataFamilyScheme rdf:type owl:NamedIndividual ,
                                  skos:ConceptScheme ;
                         skos:definition "Controlled vocabulary of the data type families relevant to NaTech risk management in HARMONI, as listed in Table 6.1 of D1.1."@en ;
                         skos:prefLabel "HARMONI data type family scheme"@en .


###  http://harmoni-project.eu/ontology#Drought
harmoni:Drought rdf:type owl:NamedIndividual ,
