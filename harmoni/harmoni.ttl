harmoni:AFADEarthquakeCatalogue rdf:type owl:NamedIndividual ,
                                         dcat:Dataset ;
                                harmoni:hasAccessTier harmoni:OpenAccess ;
                                harmoni:relevantToHazard harmoni:Earthquake ;
                                harmoni:usedInUseCase harmoni:UC2 ;
                                dcterms:publisher harmoni:AFAD ;
                                dcterms:spatial harmoni:Turkiye ;
                                dcat:theme harmoni:SeismicGroundMotion ;
                                dcterms:title "AFAD national Earthquake Catalogue"@en ;
                                dcat:landingPage <https://deprem.afad.gov.tr/> .


###  http://harmoni-project.eu/ontology#ANAR
harmoni:ANAR rdf:type owl:NamedIndividual ,
