@prefix : <https://onto.vaimee.com/pac#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix paca: <https://onto.vaimee.com/pac/aggregator#> .
@prefix pacc: <https://onto.vaimee.com/pac/consumer#> .
@prefix pacp: <https://onto.vaimee.com/pac/producer#> .
@prefix pacq: <https://onto.vaimee.com/pac/query#> .
@prefix pacu: <https://onto.vaimee.com/pac/update#> .
@base <https://onto.vaimee.com/pac#> .

<https://onto.vaimee.com/pac#> rdf:type owl:Ontology ;
                                  owl:imports <http://xmlns.com/foaf/0.1/> ;
                                  rdfs:comment "This is an ontology for PAC applications developed by VAIMEE. It integrates some classes and properties from FOAF."@en ;
                                  owl:versionIRI <https://onto.vaimee.com/pac/1.0.24#> ;
                                  owl:versionInfo "1.0.24" ;
                                  owl:title "PAC Ontology"@en ;
                                  rdfs:seeAlso paca: ,
                                               pacc: ,
                                               pacp: ,
                                               pacq: ,
                                               pacu: ;
                                  dct:abstract "Ontology to describe PAC files and related concepts."@en ;
                                  dct:description "Longer intro text shown in the Introduction section."@en ;
                                  dct:creator "Adelina Vivaldo" , "Luca Roffia" ;
                                  dct:contributor <http://adelinavivaldo> , <https://qrfy.io/p/BJOemlfU0F> .
                                  <http://adelinavivaldo> foaf:name "Adelina Vivaldo" ; foaf:member <http://vaimee.com> .
                                  <http://vaimee.com> foaf:name "VAIMEE" ; foaf:homepage "https://vaimee.com" .
                                  <https://qrfy.io/p/BJOemlfU0F> foaf:name "Luca Roffia" ; foaf:member <https://vaimee.com> .
                                  <https://vaimee.com> foaf:name "VAIMEE srl" ; foaf:homepage "https://vaimee.com" .


#################################################################
#    Object Properties
#################################################################

###  https://onto.vaimee.com/pac#dataType
:dataType rdf:type owl:ObjectProperty ;
          rdfs:domain :LiteralForcedBinding ;
          rdfs:range :DataType ;
          rdfs:label "data type"@en .


###  https://onto.vaimee.com/pac#hasComponent
:hasComponent rdf:type owl:ObjectProperty ;
              rdfs:domain :Pac ;
              rdfs:range :PacComponent ;
              owl:propertyChainAxiom ( :includesOperation
                                       [ owl:inverseOf :performsQuery
                                       ]
                                     ) ,
                                     ( :includesOperation
                                       [ owl:inverseOf :performsSubscription
                                       ]
                                     ) ,
                                     ( :includesOperation
                                       [ owl:inverseOf :performsUpdate
                                       ]
                                     ) ;
              rdfs:comment "Inferred link: a PAC is associated with a PAC component if the component uses an operation defined within the PAC."@en ;
              rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
              rdfs:label "has component"@en .


###  https://onto.vaimee.com/pac#hasForcedBinding
:hasForcedBinding rdf:type owl:ObjectProperty ;
       rdfs:domain :Operation ;
       rdfs:range [ rdf:type owl:Class ;
                    owl:unionOf ( :LiteralForcedBinding
                                  :UriForcedBinding
                                )
                  ] ;
       rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
       rdfs:label "has forced binding"@en .


###  https://onto.vaimee.com/pac#hasBinding
:hasBinding rdf:type owl:ObjectProperty ;
            rdfs:domain :ForcedBindingSet ;
            rdfs:range :ForcedBinding ;
            rdfs:comment "Associates one runtime binding set with the forced bindings that are applied together during one operation execution."@en ;
            rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
            rdfs:label "has binding"@en .


###  https://onto.vaimee.com/pac#hasBindingSet
:hasBindingSet rdf:type owl:ObjectProperty ;
               rdfs:domain :MultipleForcedBindings ;
               rdfs:range :ForcedBindingSet ;
               rdfs:comment "Associates multiple forced bindings with the binding sets used to execute the same update repeatedly with different values."@en ;
               rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
               rdfs:label "has binding set"@en .


###  https://onto.vaimee.com/pac#hasNamespace
:hasNamespace rdf:type owl:ObjectProperty ;
              rdfs:domain :Pac ;
              rdfs:range :Namespace ;
              rdfs:comment "Links a PAC instance to a RDF namespace."@en ;
              rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
              rdfs:label "has namespace"@en .


###  https://onto.vaimee.com/pac#includesOperation
:includesOperation rdf:type owl:ObjectProperty ;
                   owl:inverseOf :isOperationOf ;
                   rdfs:domain :Pac ;
                   rdfs:range :Operation ;
                   rdfs:comment "Associates a PAC with the operations it contains,"@en ;
                   rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
                   rdfs:label "includes operation"@en .


###  https://onto.vaimee.com/pac#isOperationOf
:isOperationOf rdf:type owl:ObjectProperty ;
               rdfs:domain :Operation ;
               rdfs:range :Pac ;
                rdfs:comment "Indicates that a given operation is used from a PAC."@en ;
                rdfs:label "is operation of"@en .


###  https://onto.vaimee.com/pac#graphTemplateBinding
:graphTemplateBinding rdf:type owl:ObjectProperty ;
                      rdfs:domain :InstanceNamedGraph ;
                      rdfs:range :ForcedBinding ;
                      rdfs:comment "Associates an instance-scoped graph URI template with the forced binding used to resolve the graph URI at runtime."@en ;
                      rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
                      rdfs:label "graph template binding"@en .


###  https://onto.vaimee.com/pac#performsQuery
:performsQuery rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
                rdfs:domain :PacComponent ;
                rdfs:range :Query ;
                rdfs:comment "Declares the unique SPARQL query operation implemented by a PAC component. The query can be invoked directly or used as the query behind a subscription."@en ;
                rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
                rdfs:label "performs query"@en .


###  https://onto.vaimee.com/pac#performsSubscription
:performsSubscription rdf:type owl:ObjectProperty ,
                                owl:FunctionalProperty ;
                       rdfs:subPropertyOf :performsQuery ;
                       rdfs:domain :PacComponent ;
                       rdfs:range :Query ;
                       rdfs:comment "Declares the unique SPARQL query used by a PAC component as a subscription to continuously monitor changes in the knowledge graph. It is typically used to trigger reactive behavior."@en ;
                       rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
                       rdfs:label "performs subscription"@en .


###  https://onto.vaimee.com/pac#performsUpdate
:performsUpdate rdf:type owl:ObjectProperty ,
                         owl:FunctionalProperty ;
                rdfs:domain :PacComponent ;
                rdfs:range :Update ;
                rdfs:comment "Declares that the PAC component performs a SPARQL update operation that modifies the knowledge graph (e.g., INSERT, DELETE). Each component can make at most one update."@en ;
                rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
                rdfs:label "performs update"@en .


###  https://onto.vaimee.com/pac#readsFromGraph
:readsFromGraph rdf:type owl:ObjectProperty ;
                rdfs:domain :Operation ;
                rdfs:range :NamedGraph ;
                rdfs:comment "Declares a named graph from which a query or update reads data. Reads can target either historical graphs or live graphs."@en ;
                rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
                rdfs:label "reads from graph"@en .


###  https://onto.vaimee.com/pac#subscribesToGraph
:subscribesToGraph rdf:type owl:ObjectProperty ;
                   rdfs:domain :Query ;
                   rdfs:range :LiveGraph ;
                   rdfs:comment "Declares a live named graph monitored by a subscription query."@en ;
                   rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
                   rdfs:label "subscribes to graph"@en .


###  https://onto.vaimee.com/pac#usesSnippet
:usesSnippet rdf:type owl:ObjectProperty ;
             rdfs:domain :Operation ;
             rdfs:range :Snippet ;
             rdfs:comment "Indicates that the operation reuses a predefined SPARQL snippet."@en ;
              rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
              rdfs:label "uses snippet"@en .


###  https://onto.vaimee.com/pac#hasMultipleForcedBindings
:hasMultipleForcedBindings rdf:type owl:ObjectProperty ;
                           rdfs:domain :Update ;
                           rdfs:range :MultipleForcedBindings ;
                           rdfs:comment "Associates an update with the grouped forced bindings used to execute the update multiple times, producing many triples from the same template."@en ;
                           rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
                           rdfs:label "has multiple forced bindings"@en .


###  https://onto.vaimee.com/pac#usesTemplate
:usesTemplate rdf:type owl:ObjectProperty ;
              rdfs:domain :Operation ;
              rdfs:range :Template ;
              rdfs:comment "Associates an operation with the SPARQL template from which its executable query or update is generated."@en ;
              rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
              rdfs:label "uses template"@en .


###  https://onto.vaimee.com/pac#writesToGraph
:writesToGraph rdf:type owl:ObjectProperty ;
               rdfs:domain :Update ;
               rdfs:range :HistoricalGraph ;
               rdfs:comment "Declares a historical named graph written by an update."@en ;
               rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
               rdfs:label "writes to graph"@en .


#################################################################
#    Data properties
#################################################################

###  https://onto.vaimee.com/pac#defaultValue
:defaultValue rdf:type owl:DatatypeProperty ;
              rdfs:domain :LiteralForcedBinding ,
                          :UriForcedBinding ;
              rdfs:comment "The value assigned to the variable in the binding."@en ;
              rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
              rdfs:label "default value"@en .


###  https://onto.vaimee.com/pac#variableName
:variableName rdf:type owl:DatatypeProperty ;
      rdfs:domain [ rdf:type owl:Class ;
                    owl:unionOf ( :LiteralForcedBinding
                                  :UriForcedBinding
                                )
                  ] ;
      rdfs:range xsd:string ;
      rdfs:comment "The name of the variable being bound."@en ;
      rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
      rdfs:label "variable name"@en .


###  https://onto.vaimee.com/pac#graphUri
:graphUri rdf:type owl:DatatypeProperty ;
          rdfs:domain :FixedNamedGraph ;
          rdfs:range xsd:anyURI ;
          rdfs:comment "The fixed URI of a named graph."@en ;
          rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
          rdfs:label "graph URI"@en .


###  https://onto.vaimee.com/pac#graphUriTemplate
:graphUriTemplate rdf:type owl:DatatypeProperty ;
                  rdfs:domain :InstanceNamedGraph ;
                  rdfs:range xsd:string ;
                  rdfs:comment "Template used to derive a named graph URI from one or more runtime bindings."@en ;
                  rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
                  rdfs:label "graph URI template"@en .


###  https://onto.vaimee.com/pac#prefix
:prefix rdf:type owl:DatatypeProperty ;
        rdfs:domain :Namespace ;
        rdfs:range xsd:string ;
        rdfs:comment "Represents the shorthand prefix used for the namespace (e.g., 'rdf', 'schema')."@en ;
        rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
        rdfs:label "prefix"@en .


###  https://onto.vaimee.com/pac#snippetBody
:snippetBody rdf:type owl:DatatypeProperty ;
             rdfs:domain :Snippet ;
             rdfs:range xsd:string ;
             rdfs:comment "The SPARQL code fragment that can be reused in operations."@en ;
             rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
             rdfs:label "snippet body"@en .


###  https://onto.vaimee.com/pac#sparql
:sparql rdf:type owl:DatatypeProperty ;
        rdfs:domain :Operation ;
        rdfs:range xsd:string ;
        rdfs:comment "The SPARQL query or update string."@en ;
        rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
        rdfs:label "sparql"@en .


###  https://onto.vaimee.com/pac#templateBody
:templateBody rdf:type owl:DatatypeProperty ;
              rdfs:domain :Template ;
              rdfs:range xsd:string ;
              rdfs:comment "The SPARQL text of a reusable query or update template before forced bindings are applied."@en ;
              rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
              rdfs:label "template body"@en .


#################################################################
#    Classes
#################################################################

###  https://onto.vaimee.com/pac#Aggregator
:Aggregator rdf:type owl:Class ;
            owl:equivalentClass [ owl:intersectionOf ( :PacComponent
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :performsSubscription ;
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass :Query
                                                       ]
                                                       [ rdf:type owl:Restriction ;
                                                         owl:onProperty :performsUpdate ;
                                                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                         owl:onClass :Update
                                                       ]
                                                     ) ;
                                   rdf:type owl:Class
                                 ] ;
            rdfs:subClassOf :PacComponent ;
            rdfs:comment "A reusable PAC component that reacts to notifications from one subscription query and performs one update."@en ;
            rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
            rdfs:label "Aggregator"@en .


###  https://onto.vaimee.com/pac#Consumer
:Consumer rdf:type owl:Class ;
          owl:equivalentClass [ owl:intersectionOf ( :PacComponent
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :performsQuery ;
                                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                        owl:onClass :Query
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
          rdfs:subClassOf :PacComponent ;
          rdfs:comment "A reusable PAC component bound to one SPARQL query. The query can be invoked directly or used as a subscription by specialized components."@en ;
          rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
          rdfs:label "Consumer"@en .


###  https://onto.vaimee.com/pac#DataType
:DataType rdf:type owl:Class ;
          owl:equivalentClass [ rdf:type owl:Class ;
                                owl:oneOf ( xsd:anyURI
                                            xsd:boolean
                                            xsd:byte
                                            xsd:dateTime
                                            xsd:decimal
                                            xsd:double
                                            xsd:float
                                            xsd:int
                                            xsd:integer
                                            xsd:language
                                            xsd:long
                                            xsd:negativeInteger
                                            xsd:nonNegativeInteger
                                            xsd:normalizedString
                                            xsd:positiveInteger
                                            xsd:short
                                            xsd:string
                                            xsd:token
                                            xsd:unsignedByte
                                            xsd:unsignedInt
                                            xsd:unsignedLong
                                            xsd:unsignedShort
                                          )
                              ] ;
          rdfs:label "Data Type"@en .


###  https://onto.vaimee.com/pac#ForcedBinding
:ForcedBinding rdf:type owl:Class ;
               rdfs:subClassOf :SparqlFragment ;
               rdfs:comment "Represents a forced variable binding used in a SPARQL operation within a PAC."@en ;
               rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
               rdfs:label "Forced Binding"@en .


###  https://onto.vaimee.com/pac#ForcedBindingSet
:ForcedBindingSet rdf:type owl:Class ;
                  rdfs:comment "A set of forced bindings applied together as one runtime execution context for a query or update."@en ;
                  rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
                  rdfs:label "Forced Binding Set"@en .


###  https://onto.vaimee.com/pac#FixedNamedGraph
:FixedNamedGraph rdf:type owl:Class ;
                 rdfs:subClassOf :NamedGraph ;
                 rdfs:comment "A named graph whose URI is fixed in the PAC description."@en ;
                 rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
                 rdfs:label "Fixed Named Graph"@en .


###  https://onto.vaimee.com/pac#HistoricalGraph
:HistoricalGraph rdf:type owl:Class ;
                 rdfs:subClassOf :NamedGraph ;
                 rdfs:comment "A persisted named graph that can be queried and updated."@en ;
                 rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
                 rdfs:label "Historical Graph"@en .


###  https://onto.vaimee.com/pac#InstanceNamedGraph
:InstanceNamedGraph rdf:type owl:Class ;
                    rdfs:subClassOf :NamedGraph ;
                    rdfs:comment "A named graph whose URI is derived at runtime from an instance identifier or other forced binding."@en ;
                    rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
                    rdfs:label "Instance Named Graph"@en .


###  https://onto.vaimee.com/pac#LiveGraph
:LiveGraph rdf:type owl:Class ;
           rdfs:subClassOf :NamedGraph ;
           rdfs:comment "A live named graph that can be subscribed to for notifications."@en ;
           rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
           rdfs:label "Live Graph"@en .


###  https://onto.vaimee.com/pac#Pac
:Pac rdf:type owl:Class ;
      rdfs:comment "Defines a PAC (JSON SPARQL Application Profile).  PAC describes an application based on the SPARQL Event Processing Architecture (SEPA) and following the application design pattern named PAC (Producer-Aggregator-Consumer)."@en ;
      rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
      rdfs:label "Pac"@en .


###  https://onto.vaimee.com/pac#LiteralForcedBinding
:LiteralForcedBinding rdf:type owl:Class ;
            rdfs:subClassOf :ForcedBinding ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :dataType ;
                             owl:someValuesFrom :DataType
                           ] ,
                           [ rdf:type owl:Restriction ;
                             owl:onProperty :defaultValue ;
                             owl:cardinality "1"^^xsd:nonNegativeInteger
                           ] ,
                           [ rdf:type owl:Restriction ;
                              owl:onProperty :variableName ;
                             owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                             owl:onDataRange xsd:string
                           ] ;
            owl:disjointWith :UriForcedBinding ;
            rdfs:comment "A forced binding whose value is a literal."@en ;
            rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
            rdfs:label "Literal Forced Binding"@en .


###  https://onto.vaimee.com/pac#Namespace
:Namespace rdf:type owl:Class ;
           rdfs:comment "Represents an RDF namespace. They allow grouping related terms (classes and properties) under a common base URI."@en ;
            rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
            rdfs:label "Namespace"@en .


###  https://onto.vaimee.com/pac#NamedGraph
:NamedGraph rdf:type owl:Class ;
            owl:disjointUnionOf ( :HistoricalGraph
                                  :LiveGraph
                                ) ,
                                ( :FixedNamedGraph
                                  :InstanceNamedGraph
                                ) ;
            rdfs:comment "A SPARQL named graph used by PAC operations. Named graphs can be historical, live, fixed by URI, or resolved from runtime bindings."@en ;
            rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
            rdfs:label "Named Graph"@en .


###  https://onto.vaimee.com/pac#MultipleForcedBindings
:MultipleForcedBindings rdf:type owl:Class ;
                        rdfs:comment "A collection of binding sets used to execute an update multiple times, replacing the same template variables with different values for each execution."@en ;
                        rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
                        rdfs:label "Multiple Forced Bindings"@en .


###  https://onto.vaimee.com/pac#Operation
:Operation rdf:type owl:Class ;
           rdfs:comment "An abstract superclass representing any operation described in a PAC."@en ;
           rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
           rdfs:label "Operation"@en .


###  https://onto.vaimee.com/pac#PacComponent
:PacComponent rdf:type owl:Class ;
              rdfs:subClassOf <http://xmlns.com/foaf/0.1/Agent> ;
              rdfs:comment "A component in a PAC application following the PAC (Producer-Aggregator-Consumer) architectural pattern."@en ;
              rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
              rdfs:label "Pac Component"@en .


###  https://onto.vaimee.com/pac#Producer
:Producer rdf:type owl:Class ;
          owl:equivalentClass [ owl:intersectionOf ( :PacComponent
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty :performsUpdate ;
                                                        owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                                        owl:onClass :Update
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
          rdfs:subClassOf :PacComponent ;
          rdfs:comment "A reusable PAC component bound to one SPARQL update."@en ;
          rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
          rdfs:label "Producer"@en .


###  https://onto.vaimee.com/pac#Query
:Query rdf:type owl:Class ;
       rdfs:subClassOf :SparqlOperation ;
       rdfs:comment "A SPARQL operation that retrieves information from a knowledge base without modifying it. Examples include SELECT, ASK, and CONSTRUCT queries."@en ;
       rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
       rdfs:label "Query"@en .


###  https://onto.vaimee.com/pac#Rule
:Rule rdf:type owl:Class ;
      rdfs:subClassOf :Operation ;
      rdfs:comment "A general-purpose rule defined within a PAC configuration. A rule can express declarative logic or behavior that triggers specific operations (e.g., updates) under certain conditions."@en ;
      rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
      rdfs:label "Rule"@en .


###  https://onto.vaimee.com/pac#SparqlFragment
:SparqlFragment rdf:type owl:Class ;
                rdfs:comment "Defines a fragment of SPARQL that can be inserted into queries or updates, typically through variable substitution or templating mechanisms."@en ;
                rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
                rdfs:label "Sparql Fragment"@en .


###  https://onto.vaimee.com/pac#SparqlOperation
:SparqlOperation rdf:type owl:Class ;
                 rdfs:subClassOf :Operation ;
                 rdfs:comment "Abstract superclass for SPARQL-based operations. It encompasses both queries and updates that interact with the RDF knowledge base using SPARQL 1.1 syntax."@en ;
                 rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
                 rdfs:label "Sparql Operation"@en .


###  https://onto.vaimee.com/pac#Snippet
:Snippet rdf:type owl:Class ;
         rdfs:subClassOf :SparqlFragment ;
         rdfs:comment "Represents a reusable SPARQL code fragment that can be included in one or more operations."@en ;
         rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
         rdfs:label "Snippet"@en .


###  https://onto.vaimee.com/pac#Template
:Template rdf:type owl:Class ;
          rdfs:subClassOf :SparqlFragment ;
          rdfs:comment "Reusable SPARQL query or update text containing variables that can be replaced by forced bindings at runtime."@en ;
          rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
          rdfs:label "Template"@en .


###  https://onto.vaimee.com/pac#Update
:Update rdf:type owl:Class ;
        rdfs:subClassOf :SparqlOperation ;
        rdfs:comment "A SPARQL operation that modifies the knowledge base by inserting, deleting, or updating triples. Examples include INSERT DATA, DELETE DATA, and DELETE/INSERT operations."@en ;
        rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
        rdfs:label "Update"@en .


###  https://onto.vaimee.com/pac#UriForcedBinding
:UriForcedBinding rdf:type owl:Class ;
       rdfs:subClassOf :ForcedBinding ,
                       [ rdf:type owl:Restriction ;
                         owl:onProperty :defaultValue ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:anyURI
                       ] ,
                       [ rdf:type owl:Restriction ;
                          owl:onProperty :variableName ;
                         owl:qualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                         owl:onDataRange xsd:string
                       ] ;
       rdfs:comment "A forced binding whose value is a URI."@en ;
       rdfs:isDefinedBy <https://onto.vaimee.com/pac> ;
       rdfs:label "Uri Forced Binding"@en .


#################################################################
#    Individuals
#################################################################

###  http://www.w3.org/2001/XMLSchema#anyURI
xsd:anyURI rdf:type owl:NamedIndividual .


###  http://www.w3.org/2001/XMLSchema#boolean
xsd:boolean rdf:type owl:NamedIndividual .


###  http://www.w3.org/2001/XMLSchema#byte
xsd:byte rdf:type owl:NamedIndividual .


###  http://www.w3.org/2001/XMLSchema#dateTime
